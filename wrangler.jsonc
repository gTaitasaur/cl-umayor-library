{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cl-umayor-library",
	"compatibility_date": "2026-11-03",
	"main": "src/api/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cl-umayor-library-db",
			"database_id": "211b2c2d-b931-4aaf-b8a9-c5938a2b90bc"
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://cl-umayor-library.gtaitasaur.workers.dev,http://localhost:4321,http://127.0.0.1:4321,http://localhost:8787,http://127.0.0.1:8787"
	}
}