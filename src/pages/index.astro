---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LibraryStage from '../components/LibraryStage.astro';

const allBooks = await getCollection('libros');

const sortedBooks = allBooks.sort((a, b) => {
  if (a.data.year !== b.data.year) {
    return a.data.year - b.data.year;
  }
  return a.data.month - b.data.month;
});
---

<Layout
  title="Club de Lectura UM - Temuco"
  description="Explora nuestra estantería 3D y descubre los libros leídos en el Club de Lectura UM. Revisa fichas técnicas, sinopsis y comentarios de cada obra."
>
  <LibraryStage entries={sortedBooks} />
</Layout>
