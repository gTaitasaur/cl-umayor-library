---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Club de Lectura · Archivo Editorial 3D',
  description = 'Biblioteca interactiva 3D del Club de Lectura organizada cronológicamente por años y meses.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EDE2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper-bg: #f2ede2;
    --paper-vignette: #e4dccb;
    --paper-sheet: #f7f3ea;
    --paper-page-edge: #ebe3d1;
    --ink: #181614;
    --ink-soft: #3b3630;
    --ink-muted: #6c6459;
    --rule: rgba(24, 22, 20, 0.14);
    --rule-strong: rgba(24, 22, 20, 0.28);
    --cobalt: #1b3fa8;
    --cobalt-deep: #143186;
    --vermilion: #b63b2a;

    --font-display: 'Instrument Serif', Georgia, serif;
    --font-editorial: 'Newsreader', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    background-color: var(--paper-bg);
    color: var(--ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    user-select: none;
    -webkit-user-select: none;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }

  :where(a:any-link, button, [tabindex]):focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .visually-hidden:where(:not(:focus-within, :active)) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }

  @media (pointer: fine) {
    body.has-custom-cursor,
    body.has-custom-cursor button,
    body.has-custom-cursor a {
      cursor: none;
    }
  }
</style>
