---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Club de Lectura · Archivo Editorial 3D',
  description = 'Biblioteca interactiva 3D del Club de Lectura organizada cronológicamente por años y meses.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EDE2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* 1. Superficie y textura de papel de algodón (Munken / Fabriano) */
    --paper-bg: #f2ede2;
    --paper-vignette: #e4dccb;
    --paper-sheet: #f7f3ea;
    --paper-page-edge: #ebe3d1;

    /* 2. Tintas tipográficas */
    --ink: #181614;
    --ink-soft: #2e3b3e;
    --ink-muted: #36545f; /* Apagado Oscuro: foliado, subtítulos técnicos y notas */

    /* 3. Filetes editoriales con sutil tinte de imprenta */
    --rule: rgba(54, 84, 95, 0.14);
    --rule-strong: rgba(12, 116, 124, 0.26);

    /* 4. Identidad Institucional SIBUM (Paleta extraída del logo) */
    --brand-petrol: #0c747c;       /* Vibrante Oscuro: acento principal de interacción */
    --brand-petrol-deep: #085258;  /* Sombra y hover profundo */
    --brand-petrol-slate: #36545f; /* Apagado Oscuro: foliado, subtítulos y metadatos */
    --brand-petrol-soft: #6d9a9f;  /* Apagado: reglas y bordes intermedios */
    --brand-petrol-mist: #9dc1c5;  /* Apagado Claro: fondos pasivos y selección */

    --brand-gold: #fbcb0a;         /* Vibrante: sol central, pan de oro y sellos */
    --brand-gold-warm: #e7cd52;    /* Vibrante Claro: iluminación editorial y badges */
    --brand-crimson: #b91c3b;      /* Rojo carmesí del logo: avisos y cintas marcapáginas */

    /* Tokens semánticos de compatibilidad */
    --cobalt: var(--brand-petrol);
    --cobalt-deep: var(--brand-petrol-deep);
    --vermilion: var(--brand-crimson);

    --font-display: 'Instrument Serif', Georgia, serif;
    --font-editorial: 'Newsreader', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    background-color: var(--paper-bg);
    color: var(--ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    user-select: none;
    -webkit-user-select: none;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }

  :where(a:any-link, button, [tabindex]):focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .visually-hidden:where(:not(:focus-within, :active)) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }

  @media (pointer: fine) {
    body.has-custom-cursor,
    body.has-custom-cursor button,
    body.has-custom-cursor a {
      cursor: none;
    }
  }
</style>
