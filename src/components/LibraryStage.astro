<script>
  interface BookRecord {
    index: number;
    slug: string;
    title: string;
    author: string;
    year: number;
    month: number;
    monthCode: string;
    monthName: string;
    cover: string;
    spineImage: string | null;
    spineColor: string;
    spineTextColor: string;
    accentColor: string;
    thickness: number;
    pages: number;
    genre: string;
    rating: string;
    publisher: string | null;
    publishedYear: number | null;
    country: string | null;
    synopsis: string;
  }

  interface VirtualSlot {
    el: HTMLElement;
    book3d: HTMLElement;
    frontFace: HTMLElement;
    spineFace: HTMLElement;
    catalogCard: HTMLElement;
    reflWrap: HTMLElement;
    reflFront: HTMLElement;
    reflSpine: HTMLElement;
    vIndex: number;
    bookIndex: number;
    rawThickness: number;
    lastVisible: boolean;
    lastLit: string;
    lastFrontDisp: string;
    lastSpineDisp: string;
    lastSpineOp: string;
  }

  const dataNode = document.getElementById('books-collection-json');
  const books: BookRecord[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  const N = books.length;
  const COPIES = 3;
  const M = N * COPIES;

  try {
    // Limpieza de almacenamiento local previo para garantizar inicio completamente limpio
    for (let i = localStorage.length - 1; i >= 0; i--) {
      const k = localStorage.key(i);
      if (k && (k.startsWith('cl_reviews_') || k.startsWith('cl_reviews_v'))) {
        localStorage.removeItem(k);
      }
    }
  } catch {}

  const stageRoot = document.getElementById('stage-root') as HTMLElement;
  const shelfStage = document.getElementById('shelf-stage') as HTMLElement;
  const sizeProbe = document.getElementById('book-size-probe') as HTMLElement;
  const castShadow = document.getElementById('active-cast-shadow') as HTMLElement;

  const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const openFichaBtn = document.getElementById('open-ficha-btn') as HTMLButtonElement;

  const yearTabsWrap = document.getElementById('year-tabs') as HTMLElement;
  const yearActiveBar = document.getElementById('year-active-bar') as HTMLElement;
  const yearTabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.year-tab'));
  const monthTickBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.month-tick'));

  const counterIndexSlot = document.getElementById('counter-index-slot') as HTMLElement;
  const captionTitleSlot = document.getElementById('caption-title-slot') as HTMLElement;
  const captionSubtitleSlot = document.getElementById('caption-subtitle-slot') as HTMLElement;
  const captionYearSlot = document.getElementById('caption-year-slot') as HTMLElement;

  // Elementos del Pliego de Ficha Técnica
  const fichaSheet = document.getElementById('ficha-sheet') as HTMLElement;
  const fichaInner = document.getElementById('ficha-inner') as HTMLElement;
  const fichaCardWatermark = document.getElementById('ficha-card-watermark') as HTMLElement;
  const closeFichaBtn = document.getElementById('close-ficha-btn') as HTMLButtonElement;
  const fichaScrollCol = document.getElementById('ficha-scroll-col') as HTMLElement;
  const fichaScrollTrack = document.getElementById('ficha-scrollbar-track') as HTMLElement;
  const fichaScrollThumb = document.getElementById('ficha-scrollbar-thumb') as HTMLElement;
  const fichaFolioCode = document.getElementById('ficha-folio-code') as HTMLElement;
  const fichaSeasonTag = document.getElementById('ficha-season-tag') as HTMLElement;
  const fichaBookTitle = document.getElementById('ficha-book-title') as HTMLElement;
  const fichaAuthorLine = document.getElementById('ficha-author-line') as HTMLElement;
  const metaCycle = document.getElementById('meta-cycle') as HTMLElement;
  const metaPublished = document.getElementById('meta-published') as HTMLElement;
  const metaGenre = document.getElementById('meta-genre') as HTMLElement;
  const metaRating = document.getElementById('meta-rating') as HTMLElement;
  const fichaSynopsisLines = document.getElementById('ficha-synopsis-lines') as HTMLElement;
  const fichaPrevBookBtn = document.getElementById('ficha-prev-book') as HTMLButtonElement;
  const fichaNextBookBtn = document.getElementById('ficha-next-book') as HTMLButtonElement;

  // Elementos de Opiniones y Calificación de los Miembros
  const reviewForm = document.getElementById('review-form') as HTMLFormElement;
  const reviewAuthorName = document.getElementById('review-author-name') as HTMLInputElement;
  const reviewAuthorEmail = document.getElementById('review-author-email') as HTMLInputElement;
  const reviewCommentText = document.getElementById('review-comment-text') as HTMLTextAreaElement;
  const reviewSubmitBtn = document.getElementById('review-submit-btn') as HTMLButtonElement;
  const reviewFormFeedback = document.getElementById('review-form-feedback') as HTMLElement;
  const nameErrorMsg = document.getElementById('name-error-msg') as HTMLElement;
  const starRatingControl = document.getElementById('star-rating-control') as HTMLElement;
  const starRatingDesc = document.getElementById('star-rating-desc') as HTMLElement;
  const reviewsCatalogCount = document.getElementById('reviews-catalog-count') as HTMLElement;
  const reviewsStack = document.getElementById('reviews-stack') as HTMLElement;
  const reviewHpTrap = document.getElementById('review-hp-security-check') as HTMLInputElement | null;

  const inkRevealSvg = document.getElementById('ink-reveal-svg') as unknown as SVGSVGElement;
  const inkTurbulence = document.getElementById('ink-turbulence') as unknown as SVGFETurbulenceElement;
  const fichaInkImage = document.getElementById('ficha-ink-image') as unknown as SVGUseElement;
  const inkDrops = Array.from(document.querySelectorAll<SVGCircleElement>('.ink-drop'));

  // Cursor Magnético
  const customCursor = document.getElementById('custom-cursor') as HTMLElement;
  const cursorRing = document.getElementById('cursor-ring') as HTMLElement;
  const cursorCobaltDisk = document.getElementById('cursor-cobalt-disk') as HTMLElement;
  const cursorLine1 = document.getElementById('cursor-line-1') as HTMLElement;
  const cursorLine2 = document.getElementById('cursor-line-2') as HTMLElement;

  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pointerFineQuery = window.matchMedia('(pointer: fine)');
  let prefersReducedMotion = reducedMotionQuery.matches;
  let hasFinePointer = pointerFineQuery.matches;

  if (hasFinePointer) {
    document.body.classList.add('has-custom-cursor');
  }

  reducedMotionQuery.addEventListener('change', (e) => {
    prefersReducedMotion = e.matches;
  });
  pointerFineQuery.addEventListener('change', (e) => {
    hasFinePointer = e.matches;
    document.body.classList.toggle('has-custom-cursor', hasFinePointer);
  });

  // Inicializar orígenes explícitos en espacio SVG para los 7 círculos de la máscara de tinta
  for (const drop of inkDrops) {
    const cx = drop.dataset.cx ?? '324';
    const cy = drop.dataset.cy ?? '450';
    drop.style.transformOrigin = `${cx}px ${cy}px`;
    drop.style.transform = 'scale(0)';
  }

  // Construir registro de ranuras 3D virtuales
  const slotElements = Array.from(document.querySelectorAll<HTMLElement>('.book-slot'));
  const slots: VirtualSlot[] = slotElements.map((el) => ({
    el,
    book3d: el.querySelector('.book-3d') as HTMLElement,
    frontFace: el.querySelector('.book-face--front') as HTMLElement,
    spineFace: el.querySelector('.book-face--spine') as HTMLElement,
    catalogCard: el.querySelector('.book-catalog-card') as HTMLElement,
    reflWrap: el.querySelector('.book-refl-wrap') as HTMLElement,
    reflFront: el.querySelector('.book-refl--front') as HTMLElement,
    reflSpine: el.querySelector('.book-refl--spine') as HTMLElement,
    vIndex: Number(el.dataset.virtualIndex ?? 0),
    bookIndex: Number(el.dataset.bookIndex ?? 0),
    rawThickness: Number(el.dataset.thickness ?? 54),
    lastVisible: true,
    lastLit: '1.00',
    lastFrontDisp: 'none',
    lastSpineDisp: 'block',
    lastSpineOp: '0.50',
  }));

  // ================= GEOMETRÍA FÍSICA ACUMULADA =================
  let viewportW = window.innerWidth;
  let viewportH = window.innerHeight;
  let coverW = 282;
  let coverH = 392;
  let thicknessScale = 1;
  const slotWidths = new Float64Array(M);
  const cumCenters = new Float64Array(M);
  let totalSpanPx = 4200;
  let avgPitchPx = 62;

  function measureGeometry() {
    viewportW = window.innerWidth;
    viewportH = window.innerHeight;
    const probeRect = sizeProbe.getBoundingClientRect();
    coverW = probeRect.width > 40 ? probeRect.width : 282;
    coverH = probeRect.height > 60 ? probeRect.height : 392;
    thicknessScale = viewportW < 640 ? 0.74 : viewportW < 960 ? 0.86 : 1;
    const airGap = viewportW < 640 ? 7 : 9;

    let sumCycle = 0;
    for (let v = 0; v < M; v++) {
      const slot = slots[v];
      const scaledT = Math.round(slot.rawThickness * thicknessScale);
      slotWidths[v] = scaledT + airGap;
      if (v < N) sumCycle += slotWidths[v];
      slot.el.style.setProperty('--w', `${coverW.toFixed(1)}px`);
      slot.el.style.setProperty('--h', `${coverH.toFixed(1)}px`);
      slot.el.style.setProperty('--t', `${scaledT}px`);
    }

    cumCenters[0] = 0;
    for (let v = 1; v < M; v++) {
      cumCenters[v] = cumCenters[v - 1] + 0.5 * slotWidths[v - 1] + 0.5 * slotWidths[v];
    }

    totalSpanPx = sumCycle * COPIES;
    avgPitchPx = sumCycle / Math.max(N, 1);
    syncYearIndicator(activeBookIndex, false);
  }

  // ================= ESTADO DEL MOTOR DE FÍSICA Y CURSOR =================
  // Arrancamos en la copia central (N) posicionados en el último libro añadido
  const initialBookIdx = Math.max(0, N - 1);
  let currentPos = N + initialBookIdx;
  let targetPos = N + initialBookIdx;
  let velocity = 0;
  let activeBookIndex = initialBookIdx;

  // Arrastre (Drag)
  let isDragging = false;
  let activePointerId: number | null = null;
  let dragStartX = 0;
  let dragStartPos = 0;
  let pointerMovedPx = 0;
  let lastPointerX = 0;
  let lastPointerTime = 0;
  let pointerVelocityIdx = 0;

  // Rueda del ratón / trackpad
  let wheelSnapTimer: number | null = null;

  // Estado Ficha Técnica y Pose 3D del Ejemplar
  type FichaBookPose = 'idle' | 'pages' | 'cover';
  let isFichaOpen = false;
  let isFichaAnimating = false;
  let fichaBookPose: FichaBookPose = 'idle';
  let fichaPoseX = 0;
  let fichaPoseY = 0;
  let fichaPoseZ = 0;
  let fichaPoseRotX = 0;
  let fichaPoseRotY = 0;
  let fichaPoseRotZ = 0;
  let lastInvokerEl: HTMLElement | null = null;

  // Estado Cursor Magnético e inclinación 3D hacia el puntero
  let mouseX = viewportW * 0.5;
  let mouseY = viewportH * 0.5;
  let cursorX = mouseX;
  let cursorY = mouseY;
  let pointerSeen = false;

  type CursorMode = 'default' | 'compact' | 'cover';
  let cursorMode: CursorMode = 'default';
  let ringScale = 0;
  let cobaltScale = 0;

  let targetTiltX = 0;
  let targetTiltY = 0;
  let currentTiltX = 0;
  let currentTiltY = 0;

  // ================= UTILIDADES WEB ANIMATIONS API (SIN OPACITY FADES) =================
  function swapMaskedSlot(slotEl: HTMLElement, nextText: string, direction: number, delayMs = 0) {
    const existing = Array.from(slotEl.querySelectorAll<HTMLElement>('.mask-item'));
    const currentLast = existing[existing.length - 1];
    if (currentLast && currentLast.textContent?.trim() === nextText.trim()) {
      return;
    }

    const dur = prefersReducedMotion ? 210 : 480;
    const shiftOut = direction >= 0 ? '-118%' : '118%';
    const shiftIn = direction >= 0 ? '118%' : '-118%';

    for (const oldSpan of existing) {
      const animOut = oldSpan.animate(
        [{ transform: 'translateY(0%)' }, { transform: `translateY(${shiftOut})` }],
        {
          duration: dur,
          delay: delayMs,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );
      animOut.onfinish = () => oldSpan.remove();
    }

    const incoming = document.createElement('span');
    incoming.className = currentLast ? currentLast.className : 'mask-item';
    incoming.textContent = nextText;
    incoming.style.transform = `translateY(${shiftIn})`;
    slotEl.appendChild(incoming);

    incoming.animate(
      [{ transform: `translateY(${shiftIn})` }, { transform: 'translateY(0%)' }],
      {
        duration: dur,
        delay: delayMs,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards',
      }
    );
  }

  function syncYearIndicator(bookIdx: number, animate = true) {
    const book = books[bookIdx];
    if (!book) return;

    for (const btn of yearTabBtns) {
      const yr = Number(btn.dataset.year);
      const isSelected = yr === book.year;
      btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      if (isSelected) {
        const wrapRect = yearTabsWrap.getBoundingClientRect();
        const btnRect = btn.getBoundingClientRect();
        if (wrapRect.width > 0 && btnRect.width > 0) {
          const offsetX = btnRect.left - wrapRect.left - 3;
          const scaleX = btnRect.width / 64;
          const targetTransform = `translateX(${offsetX.toFixed(1)}px) scaleX(${scaleX.toFixed(4)})`;
          if (animate && !prefersReducedMotion) {
            yearActiveBar.animate(
              [
                { transform: yearActiveBar.style.transform || targetTransform },
                { transform: targetTransform },
              ],
              {
                duration: 380,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                fill: 'forwards',
              }
            );
          }
          yearActiveBar.style.transform = targetTransform;
        }
      }
    }

    for (const tick of monthTickBtns) {
      const m = Number(tick.dataset.month);
      const active = m === book.month;
      tick.classList.toggle('is-active', active);
      if (active) {
        tick.setAttribute('aria-current', 'true');
      } else {
        tick.removeAttribute('aria-current');
      }
    }
  }

  function updateActiveBookUI(nextBookIdx: number, direction: number) {
    if (nextBookIdx === activeBookIndex) return;
    activeBookIndex = nextBookIdx;
    const book = books[nextBookIdx];
    if (!book) return;

    swapMaskedSlot(counterIndexSlot, String(nextBookIdx + 1).padStart(2, '0'), direction, 0);
    swapMaskedSlot(captionTitleSlot, book.title, direction, 0);
    swapMaskedSlot(
      captionSubtitleSlot,
      `${book.author.toUpperCase()}${book.publishedYear ? ` · ${book.publishedYear}` : ''}`,
      direction,
      prefersReducedMotion ? 0 : 40
    );
    swapMaskedSlot(
      captionYearSlot,
      `${book.monthName.toUpperCase()} ${book.year} · ${book.pages} PÁGS.`,
      direction,
      prefersReducedMotion ? 0 : 75
    );

    syncYearIndicator(nextBookIdx, true);
  }

  function setCursorMode(nextMode: CursorMode) {
    if (cursorMode === nextMode) return;
    const prevMode = cursorMode;
    cursorMode = nextMode;

    if (nextMode === 'cover') {
      const dur = prefersReducedMotion ? 180 : 340;
      cursorLine1.animate(
        [{ transform: 'translateY(115%)' }, { transform: 'translateY(0%)' }],
        { duration: dur, delay: 45, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
      );
      cursorLine2.animate(
        [{ transform: 'translateY(115%)' }, { transform: 'translateY(0%)' }],
        { duration: dur, delay: 95, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
      );
    } else if (prevMode === 'cover') {
      const dur = prefersReducedMotion ? 140 : 220;
      cursorLine1.animate(
        [{ transform: 'translateY(0%)' }, { transform: 'translateY(-115%)' }],
        { duration: dur, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
      );
      cursorLine2.animate(
        [{ transform: 'translateY(0%)' }, { transform: 'translateY(-115%)' }],
        { duration: dur, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
      );
    }
  }

  // ================= NAVEGACIÓN DE LA ESTANTERÍA =================
  function stepBy(delta: number) {
    targetPos = Math.round(targetPos + delta);
  }

  function jumpToBookIndex(destBookIdx: number) {
    const currentMod = ((Math.round(targetPos) % N) + N) % N;
    let diff = destBookIdx - currentMod;
    if (diff > N / 2) diff -= N;
    if (diff < -N / 2) diff += N;
    targetPos = Math.round(targetPos) + diff;
  }

  function findActiveVirtualSlot(): VirtualSlot {
    const posMod = ((currentPos % M) + M) % M;
    let bestSlot = slots[0];
    let bestDist = Infinity;
    for (let v = 0; v < M; v++) {
      const d = Math.abs((((v - posMod) % M) + M + M * 0.5) % M - M * 0.5);
      if (d < bestDist) {
        bestDist = d;
        bestSlot = slots[v];
      }
    }
    return bestSlot;
  }

  // ================= APERTURA Y CIERRE DE FICHA TÉCNICA =================
  function splitIntoParagraphs(text: string): string[] {
    return text
      .split(/\r?\n+/)
      .map((s) => s.trim())
      .filter(Boolean);
  }

  function createMaskedLine(text: string, innerClass: string, tag: 'p' | 'div' | 'h3' = 'p') {
    const outer = document.createElement('div');
    outer.className = 'mask-reveal';
    outer.style.overflow = 'hidden';
    outer.style.display = 'block';
    const inner = document.createElement(tag);
    inner.className = `mask-reveal-inner ${innerClass}`;
    inner.textContent = text;
    inner.style.transform = 'translateY(115%)';
    outer.appendChild(inner);
    return outer;
  }

  interface MemberReview {
    id?: number | string;
    bookIndex: number;
    bookSlug: string;
    name: string;
    email?: string | null;
    rating: number;
    comment: string;
    createdAt: string;
  }

  const RATING_DESCRIPTIONS: Record<number, string> = {
    1: 'No me convenció',
    2: 'Regular',
    3: 'Buena lectura',
    4: 'Recomendada',
    5: 'Me encantó!',
  };

  function getStarSymbols(rating: number): string {
    const r = Math.max(1, Math.min(5, Math.round(rating)));
    return '★'.repeat(r) + '☆'.repeat(5 - r);
  }

  function formatReviewDate(dateStr: string): string {
    try {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return 'Reciente';
      return d.toLocaleDateString('es-CL', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      });
    } catch {
      return 'Reciente';
    }
  }

  let currentReviewBookIdx = 0;
  let currentReviewBookSlug = '';
  let activeRatingSelection = 5;

  function updateStarRatingUI(value: number) {
    activeRatingSelection = value;
    const labels = Array.from(starRatingControl.querySelectorAll<HTMLLabelElement>('.star-rating-label'));
    labels.forEach((lbl) => {
      const v = Number(lbl.dataset.value ?? 1);
      lbl.classList.toggle('is-active', v <= value);
      const radio = lbl.querySelector<HTMLInputElement>('input[type="radio"]');
      if (radio) radio.checked = v === value;
    });
    starRatingDesc.textContent = RATING_DESCRIPTIONS[value] || `${value} de 5 estrellas`;
  }

  async function loadAndDisplayReviews(bookIdx: number, slug: string) {
    currentReviewBookIdx = bookIdx;
    currentReviewBookSlug = slug;
    updateStarRatingUI(5);
    reviewFormFeedback.textContent = '';
    reviewFormFeedback.className = 'review-form-feedback';

    const nameGroup = reviewAuthorName.parentElement;
    nameGroup?.classList.remove('has-error');

    let reviews: MemberReview[] = [];
    let serverConnected = false;

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 6000);
      const res = await fetch(`/api/reviews?book=${bookIdx}&slug=${slug}`, { signal: controller.signal });
      clearTimeout(timeoutId);
      if (res.ok) {
        serverConnected = true;
        const data = await res.json();
        if (Array.isArray(data.reviews)) {
          reviews = data.reviews;
        }
      }
    } catch {
      // Modo estático o sin conexión al worker
    }

    if (!serverConnected && reviews.length === 0) {
      const local = localStorage.getItem(`cl_reviews_${bookIdx}`);
      if (local) {
        try {
          reviews = JSON.parse(local);
        } catch {}
      }
    }

    renderReviewsList(reviews);
  }

  function renderReviewsList(reviews: MemberReview[]) {
    const total = reviews.length;
    const sum = reviews.reduce((acc, r) => acc + r.rating, 0);
    const avg = total > 0 ? (sum / total).toFixed(1) : null;

    // Actualizar cuadrícula de metadatos de la ficha ("VALORACIÓN DEL CLUB")
    metaRating.textContent = total > 0
      ? `★ ${avg} / 5.0 (${total} ${total === 1 ? 'opinión' : 'opiniones'})`
      : 'Sin opiniones registradas';
    reviewsCatalogCount.textContent = `${total} ${total === 1 ? 'registro' : 'registros'}`;

    // Renderizar tarjetas de reseñas de lectores
    reviewsStack.replaceChildren();

    if (total === 0) {
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'reviews-empty-message';
      emptyDiv.textContent = 'Aún no hay opiniones registradas. ¡Sé el primero en compartir tu impresión!';
      reviewsStack.appendChild(emptyDiv);
      return;
    }

    for (const rev of reviews) {
      const card = document.createElement('article');
      card.className = 'review-card';

      // Línea 1: Nombre del usuario y fecha de publicación con separación visible
      const line1 = document.createElement('div');
      line1.className = 'review-card-line-1';

      const author = document.createElement('span');
      author.className = 'review-card-author';
      author.textContent = rev.name;

      const date = document.createElement('time');
      date.className = 'review-card-date';
      date.textContent = formatReviewDate(rev.createdAt);

      line1.appendChild(author);
      line1.appendChild(date);
      card.appendChild(line1);

      // Debajo: correo entre paréntesis en letra más pequeña y grisácea (en caso de existir)
      if (rev.email && rev.email.trim()) {
        const emailEl = document.createElement('div');
        emailEl.className = 'review-card-email';
        const clean = rev.email.trim().replace(/^\(|\)$/g, '');
        emailEl.textContent = `(${clean})`;
        card.appendChild(emailEl);
      }

      // Línea 2: Cantidad de estrellas en color dorado
      const line2 = document.createElement('div');
      line2.className = 'review-card-line-2';

      const stars = document.createElement('span');
      stars.className = 'review-card-stars';
      stars.textContent = getStarSymbols(rev.rating);
      stars.style.color = '#fac90a';
      stars.style.setProperty('color', '#fac90a', 'important');
      stars.setAttribute('aria-label', `${rev.rating} de 5 estrellas`);

      line2.appendChild(stars);
      card.appendChild(line2);

      // Línea 3: Espaciado visible para que el párrafo respire + texto del comentario
      if (rev.comment && rev.comment.trim()) {
        const line3 = document.createElement('div');
        line3.className = 'review-card-line-3';

        const commentP = document.createElement('p');
        commentP.className = 'review-card-comment';
        commentP.textContent = rev.comment;

        line3.appendChild(commentP);
        card.appendChild(line3);
      }

      reviewsStack.appendChild(card);
    }
  }

  // Interacción de hover y selección de estrellas
  const starLabels = Array.from(starRatingControl.querySelectorAll<HTMLLabelElement>('.star-rating-label'));
  starLabels.forEach((lbl) => {
    const val = Number(lbl.dataset.value ?? 1);
    lbl.addEventListener('mouseenter', () => {
      starLabels.forEach((l) => {
        const v = Number(l.dataset.value ?? 1);
        l.classList.toggle('is-hovered', v <= val);
      });
      starRatingDesc.textContent = RATING_DESCRIPTIONS[val] || `${val} de 5 estrellas`;
    });

    lbl.addEventListener('click', () => {
      updateStarRatingUI(val);
    });
  });

  starRatingControl.addEventListener('mouseleave', () => {
    starLabels.forEach((l) => l.classList.remove('is-hovered'));
    starRatingDesc.textContent = RATING_DESCRIPTIONS[activeRatingSelection] || `${activeRatingSelection} de 5 estrellas`;
  });

  // Identificador de dispositivo anónimo y persistente para Rate Limiting en redes universitarias compartidas
  function getOrCreateDeviceToken(): string {
    const KEY = 'cl_reader_device_id';
    let token = '';
    try {
      token = localStorage.getItem(KEY) || '';
    } catch {}

    if (!token || token.length < 16 || token.length > 64) {
      token = typeof crypto !== 'undefined' && crypto.randomUUID
        ? crypto.randomUUID()
        : 'cl_' + Math.random().toString(36).substring(2) + Date.now().toString(36);
      try {
        localStorage.setItem(KEY, token);
      } catch {}
    }
    return token;
  }

  // Envío del Formulario de Opiniones con Verificación AppSec
  reviewForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameVal = reviewAuthorName.value.trim();
    const emailVal = reviewAuthorEmail.value.trim();
    const commentVal = reviewCommentText.value.trim();
    const ratingVal = activeRatingSelection;
    const honeypotVal = reviewHpTrap ? reviewHpTrap.value : '';

    const nameGroup = reviewAuthorName.parentElement;
    if (!nameVal || nameVal.length < 2) {
      nameGroup?.classList.add('has-error');
      if (nameErrorMsg) nameErrorMsg.textContent = 'Por favor ingresa tu nombre (mínimo 2 caracteres).';
      reviewAuthorName.focus();
      return;
    }
    if (nameVal.length > 70) {
      nameGroup?.classList.add('has-error');
      if (nameErrorMsg) nameErrorMsg.textContent = 'El nombre no puede exceder 70 caracteres.';
      reviewAuthorName.focus();
      return;
    }
    nameGroup?.classList.remove('has-error');

    if (commentVal.length > 600) {
      reviewFormFeedback.textContent = '✕ El comentario no puede exceder los 600 caracteres.';
      reviewFormFeedback.className = 'review-form-feedback is-error';
      return;
    }

    if (emailVal.length > 100) {
      reviewFormFeedback.textContent = '✕ El correo electrónico no puede exceder los 100 caracteres.';
      reviewFormFeedback.className = 'review-form-feedback is-error';
      return;
    }

    // Heurística de cliente: Bloqueo preventivo de enlaces y spam comercial
    const spamPattern = /(https?:\/\/|www\.|\.xyz|\.top|\.click|t\.me\/|wa\.me\/|chat\.whatsapp)/i;
    if (spamPattern.test(nameVal) || spamPattern.test(commentVal) || (emailVal && spamPattern.test(emailVal))) {
      reviewFormFeedback.textContent = '✕ Por seguridad, no se admiten enlaces ni contenido promocional en los comentarios.';
      reviewFormFeedback.className = 'review-form-feedback is-error';
      return;
    }

    // Heurística de cliente: Filtro preventivo de insultos o vocabulario soez
    const profanityPattern = /\b(weon|weona|aweonao|culiao|culia|conchetumadre|conchesumadre|ctm|csm|maricon|mierda|puta|puto|hijo ?de ?puta|imbecil|estupido|tarado|porno|xxx|sexo|pene|vagina|tetas|verga|pija|follar|cojer|prostituta|escort|poto|tula|raja)\b/i;
    if (profanityPattern.test(nameVal) || profanityPattern.test(commentVal) || (emailVal && profanityPattern.test(emailVal))) {
      reviewFormFeedback.textContent = '✕ Por favor mantén un tono respetuoso. Se detectó vocabulario no permitido.';
      reviewFormFeedback.className = 'review-form-feedback is-error';
      return;
    }

    reviewSubmitBtn.disabled = true;
    const submitBtnText = reviewSubmitBtn.querySelector('.submit-btn-text');
    if (submitBtnText) submitBtnText.textContent = 'Publicando...';
    reviewFormFeedback.textContent = '';
    reviewFormFeedback.className = 'review-form-feedback';

    const payload = {
      bookIndex: currentReviewBookIdx,
      bookSlug: currentReviewBookSlug,
      name: nameVal,
      email: emailVal || null,
      rating: ratingVal,
      comment: commentVal,
      hp_security_check: honeypotVal,
      device_token: getOrCreateDeviceToken(),
    };

    let isSuccess = false;
    let feedbackMessage = '';

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 12000);
      const res = await fetch('/api/reviews', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      clearTimeout(timeoutId);

      const data = await res.json().catch(() => null);

      if (res.ok && data?.success) {
        isSuccess = true;
      } else {
        if (res.status === 429) {
          feedbackMessage = data?.error || 'Has publicado recientemente. Por favor espera antes de volver a comentar.';
        } else {
          feedbackMessage = data?.error || `Error al registrar la opinión (${res.status}).`;
        }
      }
    } catch (err: any) {
      if (err.name === 'AbortError') {
        feedbackMessage = 'La solicitud tardó demasiado tiempo. Por favor reintenta.';
      } else {
        feedbackMessage = 'No se pudo conectar con el servidor editorial.';
      }
    }

    // Si la petición fue rechazada por el backend (Rate limit, Honeypot, filtro de palabras, XSS, etc.)
    if (!isSuccess) {
      reviewFormFeedback.textContent = `✕ ${feedbackMessage}`;
      reviewFormFeedback.className = 'review-form-feedback is-error';
      reviewSubmitBtn.disabled = false;
      if (submitBtnText) submitBtnText.textContent = 'Publicar Comentario';
      return;
    }

    // Éxito confirmado por el backend: recargar inmediatamente la lista oficial y completa desde D1
    await loadAndDisplayReviews(currentReviewBookIdx, currentReviewBookSlug);

    reviewAuthorName.value = '';
    reviewAuthorEmail.value = '';
    reviewCommentText.value = '';
    if (reviewHpTrap) reviewHpTrap.value = '';
    updateStarRatingUI(5);

    reviewFormFeedback.textContent = '✓ ¡Tu comentario ha sido publicado con éxito!';
    reviewFormFeedback.className = 'review-form-feedback';

    reviewSubmitBtn.disabled = false;
    if (submitBtnText) submitBtnText.textContent = 'Publicar Comentario';

    setTimeout(() => {
      reviewFormFeedback.textContent = '';
    }, 5000);

    setTimeout(() => {
      reviewFormFeedback.textContent = '';
    }, 5000);
  });

  function populateFichaDOM(bookIdx: number) {
    const book = books[bookIdx];
    if (!book) return;

    fichaFolioCode.textContent = `REGISTRO · Nº ${String(bookIdx + 1).padStart(2, '0')} / ${String(N).padStart(2, '0')}`;
    fichaSeasonTag.textContent = `TEMPORADA ${book.year} · ${book.monthName.toUpperCase()}`;
    fichaBookTitle.textContent = book.title;
    const extraOrigin = [book.country, book.publishedYear].filter(Boolean).join(', ');
    fichaAuthorLine.textContent = extraOrigin ? `${book.author} — ${extraOrigin}` : `Por ${book.author}`;

    metaCycle.textContent = `${book.monthName} · ${book.year}`;
    metaPublished.textContent = book.publishedYear ? String(book.publishedYear) : '—';
    metaGenre.textContent = `${book.genre} · ${book.pages} págs.`;
    metaRating.textContent = `★ Calculando...`;

    // Sinopsis en párrafos fluidos editoriales con máscaras de revelado
    fichaSynopsisLines.replaceChildren();
    for (const paragraph of splitIntoParagraphs(book.synopsis)) {
      fichaSynopsisLines.appendChild(createMaskedLine(paragraph, 'synopsis-paragraph'));
    }

    // Cargar y mostrar las opiniones de los miembros para este libro
    loadAndDisplayReviews(bookIdx, book.slug);

    // Semilla única para la mancha de tinta orgánica de este libro + plantilla editorial dinámica
    inkTurbulence.setAttribute('seed', String(bookIdx * 13 + 7));
    fichaInkImage.setAttribute('href', `#editorial-cover-${bookIdx}`);
    inkRevealSvg?.setAttribute('aria-label', `Portada editorial de ${book.title}`);

    // Preparar todos los elementos enmascarados antes de animar
    const allMaskInners = fichaSheet.querySelectorAll<HTMLElement>('.mask-reveal-inner');
    for (const item of allMaskInners) {
      item.getAnimations().forEach((a) => a.cancel());
      item.style.transform = 'translateY(115%)';
      item.style.opacity = '0';
    }

    const rules = fichaSheet.querySelectorAll<HTMLElement>('.ficha-rule-scale');
    for (const r of rules) {
      r.getAnimations().forEach((a) => a.cancel());
      r.style.transform = 'scaleX(0)';
    }

    closeFichaBtn.getAnimations().forEach((a) => a.cancel());
    closeFichaBtn.style.transform = 'translateY(12px)';
    closeFichaBtn.style.opacity = '0';

    if (fichaScrollTrack) {
      fichaScrollTrack.getAnimations().forEach((a) => a.cancel());
      fichaScrollTrack.style.opacity = '0';
    }

    for (const drop of inkDrops) {
      drop.getAnimations().forEach((a) => a.cancel());
      drop.style.transform = 'scale(0)';
    }
  }

  function computeCoverCardRect(slot: VirtualSlot): {
    bx: number;
    by: number;
    sx0: number;
    sy0: number;
  } {
    const cardEl = slot.catalogCard;
    const prevTransform = cardEl.style.transform;
    cardEl.style.transform =
      'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)';
    const rect = cardEl.getBoundingClientRect();
    cardEl.style.transform = prevTransform;

    const vw = window.innerWidth;
    const vh = window.innerHeight;

    const cardW = rect.width > 20 ? rect.width : coverW * 0.88;
    const cardH = rect.height > 20 ? rect.height : coverH * 0.9;
    const cx = rect.width > 20 ? rect.left + rect.width * 0.5 : vw * 0.5;
    const cy = rect.height > 20 ? rect.top + rect.height * 0.5 : vh * 0.5;

    const bx = cx - vw * 0.5;
    const by = cy - vh * 0.5;
    const sx0 = Math.max(0.1, Math.min(0.85, cardW / vw));
    const sy0 = Math.max(0.18, Math.min(0.85, cardH / vh));

    return { bx, by, sx0, sy0 };
  }

  function animateFichaContentsIn(baseDelay = 0) {
    const durLine = prefersReducedMotion ? 240 : 820;
    const stagger = prefersReducedMotion ? 10 : 42;

    const rules = Array.from(fichaSheet.querySelectorAll<HTMLElement>('.ficha-rule-scale'));
    rules.forEach((rule, idx) => {
      rule.animate(
        [
          { transform: 'scaleX(0)', opacity: 0 },
          { transform: 'scaleX(1)', opacity: 1 },
        ],
        {
          duration: prefersReducedMotion ? 220 : 880,
          delay: baseDelay + idx * 75,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );
    });

    closeFichaBtn.getAnimations().forEach((a) => a.cancel());
    closeFichaBtn.animate(
      [
        { transform: 'translateY(12px)', opacity: 0 },
        { transform: 'translateY(0)', opacity: 1 },
      ],
      {
        duration: prefersReducedMotion ? 200 : 620,
        delay: baseDelay + 40,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards',
      }
    );

    const allMaskInners = Array.from(fichaSheet.querySelectorAll<HTMLElement>('.mask-reveal-inner'));
    allMaskInners.forEach((el, idx) => {
      el.animate(
        [
          { transform: 'translateY(115%)', opacity: 0 },
          { transform: 'translateY(0%)', opacity: 1 },
        ],
        {
          duration: durLine,
          delay: baseDelay + Math.min(idx * stagger, 980),
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards',
        }
      );
    });

    // Revelado orgánico de las 7 manchas de tinta SVG sobre el papel
    inkDrops.forEach((drop, idx) => {
      drop.animate([{ transform: 'scale(0)' }, { transform: 'scale(1)' }], {
        duration: prefersReducedMotion ? 360 : 1380 + idx * 140,
        delay: baseDelay + (prefersReducedMotion ? 40 : 110 + idx * 95),
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards',
      });
    });

    if (fichaScrollTrack) {
      updateFichaScrollbar();
      fichaScrollTrack.getAnimations().forEach((a) => a.cancel());
      fichaScrollTrack.animate(
        [
          { opacity: 0, transform: 'scaleY(0.85)' },
          { opacity: 1, transform: 'scaleY(1)' },
        ],
        {
          duration: prefersReducedMotion ? 200 : 520,
          delay: baseDelay + 240,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards',
        }
      );
    }
  }

  function openFicha(invoker?: HTMLElement) {
    if (isFichaOpen || isFichaAnimating) return;
    isFichaAnimating = true;
    isFichaOpen = true;
    lastInvokerEl = invoker ?? (document.activeElement as HTMLElement | null);

    // Centrar limpiamente el ejemplar activo
    targetPos = Math.round(currentPos);
    setCursorMode('default');
    targetTiltX = 0;
    targetTiltY = 0;
    stageRoot.inert = true;

    populateFichaDOM(activeBookIndex);
    fichaScrollCol.scrollTop = 0;

    const activeSlot = findActiveVirtualSlot();
    const card3d = activeSlot.catalogCard;

    const startSheetExpansion = () => {
      const { bx, by, sx0, sy0 } = computeCoverCardRect(activeSlot);

      // Ocultar la tarjeta 3D justo en el instante en que el pliego toma el relevo sobre la portada
      card3d.getAnimations().forEach((a) => a.cancel());
      card3d.style.visibility = 'hidden';
      card3d.style.opacity = '0';
      card3d.style.transform =
        'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)';

      fichaSheet.hidden = false;

      if (fichaInner) {
        fichaInner.getAnimations().forEach((a) => a.cancel());
        fichaInner.style.opacity = prefersReducedMotion ? '1' : '0';
        if (!prefersReducedMotion) {
          fichaInner.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 420,
            delay: 320,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'forwards',
          });
        }
      }

      if (fichaCardWatermark && !prefersReducedMotion) {
        fichaCardWatermark.getAnimations().forEach((a) => a.cancel());
        fichaCardWatermark.animate(
          [
            { opacity: 0.95 },
            { opacity: 0.9, offset: 0.32 },
            { opacity: 0 },
          ],
          {
            duration: 660,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'forwards',
          }
        );
      }

      const sheetDuration = prefersReducedMotion ? 280 : 880;
      const sheetAnim = fichaSheet.animate(
        prefersReducedMotion
          ? [
              {
                transform: 'translate3d(0px, 24px, 0) scale(0.96)',
                opacity: 0,
              },
              {
                transform: 'translate3d(0px, 0px, 0) scale(1)',
                opacity: 1,
              },
            ]
          : [
              {
                // Parte exactamente desde la portada del ejemplar 3D donde se posó la tarjeta
                transform: `translate3d(${bx.toFixed(1)}px, ${by.toFixed(1)}px, 0) rotate(0deg) scale(${sx0.toFixed(3)}, ${sy0.toFixed(3)})`,
                opacity: 1,
                borderRadius: '10px',
              },
              {
                transform: `translate3d(${(bx * 0.18).toFixed(1)}px, ${(by * 0.18).toFixed(1)}px, 0) rotate(0deg) scale(0.84, 0.88)`,
                opacity: 1,
                borderRadius: '6px',
                offset: 0.56,
              },
              {
                // Se abre a pantalla completa
                transform: 'translate3d(0px, 0px, 0) rotate(0deg) scale(1, 1)',
                opacity: 1,
                borderRadius: '0px',
              },
            ],
        {
          duration: sheetDuration,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );

      animateFichaContentsIn(prefersReducedMotion ? 80 : 340);

      sheetAnim.onfinish = () => {
        fichaSheet.style.transform = '';
        fichaSheet.style.opacity = '';
        fichaSheet.style.borderRadius = '';
        if (fichaInner) fichaInner.style.opacity = '1';
        isFichaAnimating = false;
        fichaSheet.focus({ preventScroll: true });
      };
    };

    if (prefersReducedMotion) {
      fichaBookPose = 'cover';
      startSheetExpansion();
      return;
    }

    // FASE 1 (3D): El ejemplar muestra el canto de sus páginas, la ficha sale desde entre medio
    // de las páginas (z = 0), pasa al frente y se posiciona sobre la portada (z = +t/2 + 6px)
    fichaBookPose = 'pages';
    window.setTimeout(() => {
      if (isFichaOpen) {
        fichaBookPose = 'cover';
      }
    }, 420);

    card3d.getAnimations().forEach((a) => a.cancel());
    card3d.style.visibility = 'visible';
    card3d.style.opacity = '1';

    const card3dAnim = card3d.animate(
      [
        {
          // 1. Alojada en el interior entre las páginas (z = 0, detrás de la portada)
          transform: 'translate3d(0px, 0px, 0px) rotateZ(0deg)',
        },
        {
          // 2. Sale hacia la derecha desde entre medio de las páginas del libro
          transform: 'translate3d(calc(var(--w, 282px) * 0.96), -6px, 0px) rotateZ(2.2deg)',
          offset: 0.45,
        },
        {
          // 3. Pasa por delante del plano de la portada
          transform:
            'translate3d(calc(var(--w, 282px) * 0.96), -6px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(1.5deg)',
          offset: 0.55,
        },
        {
          // 4. Se posiciona centrada sobre la portada del libro
          transform: 'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)',
          offset: 0.88,
        },
        {
          // 5. Breve pausa posada en la portada antes de abrirse
          transform: 'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)',
        },
      ],
      {
        duration: 940,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        fill: 'forwards',
      }
    );

    card3dAnim.onfinish = () => {
      startSheetExpansion();
    };
  }

  function closeFicha() {
    if (!isFichaOpen || isFichaAnimating) return;
    isFichaAnimating = true;

    const retractDur = prefersReducedMotion ? 150 : 280;

    for (const drop of inkDrops) {
      drop.animate([{ transform: 'scale(1)' }, { transform: 'scale(0)' }], {
        duration: retractDur + 40,
        easing: 'cubic-bezier(0.4, 0, 0.8, 1)',
        fill: 'forwards',
      });
    }

    const allMaskInners = Array.from(fichaSheet.querySelectorAll<HTMLElement>('.mask-reveal-inner'));
    for (const el of allMaskInners) {
      el.animate(
        [
          { transform: 'translateY(0%)', opacity: 1 },
          { transform: 'translateY(115%)', opacity: 0 },
        ],
        {
          duration: retractDur,
          easing: 'cubic-bezier(0.4, 0, 1, 1)',
          fill: 'forwards',
        }
      );
    }

    const rules = Array.from(fichaSheet.querySelectorAll<HTMLElement>('.ficha-rule-scale'));
    for (const rule of rules) {
      rule.animate(
        [
          { transform: 'scaleX(1)', opacity: 1 },
          { transform: 'scaleX(0)', opacity: 0 },
        ],
        {
          duration: retractDur,
          easing: 'cubic-bezier(0.4, 0, 1, 1)',
          fill: 'forwards',
        }
      );
    }

    closeFichaBtn.getAnimations().forEach((a) => a.cancel());
    closeFichaBtn.animate(
      [
        { transform: 'translateY(0)', opacity: 1 },
        { transform: 'translateY(12px)', opacity: 0 },
      ],
      {
        duration: retractDur,
        easing: 'cubic-bezier(0.4, 0, 1, 1)',
        fill: 'forwards',
      }
    );

    if (fichaScrollTrack) {
      fichaScrollTrack.getAnimations().forEach((a) => a.cancel());
      fichaScrollTrack.animate(
        [
          { opacity: 1, transform: 'scaleY(1)' },
          { opacity: 0, transform: 'scaleY(0.85)' },
        ],
        {
          duration: retractDur,
          easing: 'cubic-bezier(0.4, 0, 1, 1)',
          fill: 'forwards',
        }
      );
    }

    if (fichaInner && !prefersReducedMotion) {
      fichaInner.getAnimations().forEach((a) => a.cancel());
      fichaInner.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 240,
        easing: 'cubic-bezier(0.4, 0, 1, 1)',
        fill: 'forwards',
      });
    }

    if (fichaCardWatermark && !prefersReducedMotion) {
      fichaCardWatermark.getAnimations().forEach((a) => a.cancel());
      fichaCardWatermark.animate([{ opacity: 0 }, { opacity: 0.95 }], {
        duration: 320,
        delay: 60,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        fill: 'forwards',
      });
    }

    const activeSlot = findActiveVirtualSlot();
    const card3d = activeSlot.catalogCard;
    const { bx, by, sx0, sy0 } = computeCoverCardRect(activeSlot);

    // FASE 1: El pliego abierto se pliega hasta posarse exactamente sobre la portada del ejemplar 3D
    const foldAnim = fichaSheet.animate(
      prefersReducedMotion
        ? [
            {
              transform: 'translate3d(0px, 0px, 0) scale(1)',
              opacity: 1,
            },
            {
              transform: 'translate3d(0px, 24px, 0) scale(0.96)',
              opacity: 0,
            },
          ]
        : [
            {
              transform: 'translate3d(0px, 0px, 0) rotate(0deg) scale(1, 1)',
              opacity: 1,
              borderRadius: '0px',
            },
            {
              transform: `translate3d(${(bx * 0.2).toFixed(1)}px, ${(by * 0.2).toFixed(1)}px, 0) rotate(0deg) scale(0.82, 0.86)`,
              opacity: 1,
              borderRadius: '6px',
              offset: 0.42,
            },
            {
              // Aterriza posada sobre la portada del ejemplar
              transform: `translate3d(${bx.toFixed(1)}px, ${by.toFixed(1)}px, 0) rotate(0deg) scale(${sx0.toFixed(3)}, ${sy0.toFixed(3)})`,
              opacity: 1,
              borderRadius: '10px',
            },
          ],
      {
        duration: prefersReducedMotion ? 240 : 720,
        delay: prefersReducedMotion ? 20 : 80,
        easing: 'cubic-bezier(0.32, 0, 0.2, 1)',
        fill: 'forwards',
      }
    );

    const finalizeCloseCleanup = () => {
      stageRoot.inert = false;
      isFichaOpen = false;
      isFichaAnimating = false;
      if (lastInvokerEl && typeof lastInvokerEl.focus === 'function') {
        lastInvokerEl.focus({ preventScroll: true });
      }
      if (hasFinePointer && pointerSeen) {
        const hit = document.elementFromPoint(mouseX, mouseY) as HTMLElement | null;
        const hitSlot = hit?.closest<HTMLElement>('.book-slot');
        if (hitSlot) {
          const vIdx = Number(hitSlot.dataset.virtualIndex ?? 0);
          const posMod = ((currentPos % M) + M) % M;
          const d = (((vIdx - posMod) % M) + M + M * 0.5) % M - M * 0.5;
          setCursorMode(Math.abs(d) < 0.42 ? 'cover' : 'compact');
        }
      }
    };

    foldAnim.onfinish = () => {
      fichaSheet.hidden = true;
      fichaSheet.getAnimations().forEach((a) => a.cancel());
      if (fichaInner) {
        fichaInner.getAnimations().forEach((a) => a.cancel());
        fichaInner.style.opacity = '1';
      }
      if (fichaCardWatermark) {
        fichaCardWatermark.getAnimations().forEach((a) => a.cancel());
        fichaCardWatermark.style.opacity = '0';
      }
      allMaskInners.forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
        el.style.transform = 'translateY(115%)';
        el.style.opacity = '0';
      });
      rules.forEach((r) => {
        r.getAnimations().forEach((a) => a.cancel());
        r.style.transform = 'scaleX(0)';
        r.style.opacity = '0';
      });
      closeFichaBtn.getAnimations().forEach((a) => a.cancel());
      closeFichaBtn.style.transform = 'translateY(12px)';
      closeFichaBtn.style.opacity = '0';
      if (fichaScrollTrack) {
        fichaScrollTrack.getAnimations().forEach((a) => a.cancel());
        fichaScrollTrack.style.opacity = '0';
      }
      fichaSheet.style.transform = '';
      fichaSheet.style.opacity = '';
      fichaSheet.style.borderRadius = '';

      if (prefersReducedMotion) {
        fichaBookPose = 'idle';
        finalizeCloseCleanup();
        return;
      }

      // FASE 2 (3D): Desde la portada, la ficha sale hacia el canto derecho y vuelve a meterse
      // entre medio de las páginas del libro (z = 0, entre portada y contraportada)
      fichaBookPose = 'pages';
      card3d.getAnimations().forEach((a) => a.cancel());
      card3d.style.visibility = 'visible';
      card3d.style.opacity = '1';

      const stowAnim = card3d.animate(
        [
          {
            // 1. Posada sobre la portada
            transform: 'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)',
          },
          {
            // 2. Breve pausa en la portada antes de deslizarse hacia las páginas
            transform: 'translate3d(0px, 0px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(0deg)',
            offset: 0.12,
          },
          {
            // 3. Se desplaza hacia la derecha saliendo del borde de la portada
            transform:
              'translate3d(calc(var(--w, 282px) * 0.96), -6px, calc(var(--t, 54px) * 0.5 + 6px)) rotateZ(1.8deg)',
            offset: 0.48,
          },
          {
            // 4. Se alinea con el plano central de las páginas (z = 0)
            transform: 'translate3d(calc(var(--w, 282px) * 0.96), -6px, 0px) rotateZ(2.2deg)',
            offset: 0.58,
          },
          {
            // 5. Se desliza hacia adentro quedando guardada entre las páginas del libro
            transform: 'translate3d(0px, 0px, 0px) rotateZ(0deg)',
          },
        ],
        {
          duration: 920,
          easing: 'cubic-bezier(0.32, 0, 0.2, 1)',
          fill: 'forwards',
        }
      );

      stowAnim.onfinish = () => {
        card3d.getAnimations().forEach((a) => a.cancel());
        card3d.style.visibility = 'hidden';
        card3d.style.opacity = '0';
        card3d.style.transform = 'translate3d(0px, 0px, 0px)';
        fichaBookPose = 'idle';
        currentTiltX = -3.6;
        finalizeCloseCleanup();
      };
    };
  }

  function switchBookInsideFicha(delta: number) {
    if (!isFichaOpen || isFichaAnimating) return;
    stepBy(delta);
    const nextIdx = (((Math.round(targetPos) % N) + N) % N);
    updateActiveBookUI(nextIdx, delta);
    populateFichaDOM(nextIdx);
    fichaScrollCol.scrollTop = 0;
    animateFichaContentsIn(60);
  }

  // ================= SCROLLBAR EDITORIAL ANIMADA =================
  function updateFichaScrollbar() {
    if (!fichaScrollCol || !fichaScrollTrack || !fichaScrollThumb) return;
    const scrollHeight = fichaScrollCol.scrollHeight;
    const clientHeight = fichaScrollCol.clientHeight;
    const maxScroll = scrollHeight - clientHeight;

    if (maxScroll <= 4) {
      fichaScrollTrack.style.opacity = '0';
      fichaScrollTrack.style.pointerEvents = 'none';
      return;
    }

    fichaScrollTrack.style.pointerEvents = 'auto';
    const trackHeight = fichaScrollTrack.clientHeight || Math.max(clientHeight - 48, 100);
    const thumbHeight = Math.max(34, Math.min(trackHeight * 0.7, (clientHeight / scrollHeight) * trackHeight));
    fichaScrollThumb.style.height = `${thumbHeight.toFixed(1)}px`;

    const scrollTop = fichaScrollCol.scrollTop;
    const scrollProgress = Math.max(0, Math.min(1, scrollTop / maxScroll));
    const thumbTop = scrollProgress * (trackHeight - thumbHeight);
    fichaScrollThumb.style.transform = `translate3d(0, ${thumbTop.toFixed(1)}px, 0)`;
  }

  fichaScrollCol.addEventListener('scroll', updateFichaScrollbar, { passive: true });
  window.addEventListener('resize', updateFichaScrollbar, { passive: true });

  let isDraggingScrollThumb = false;
  let dragScrollStartY = 0;
  let dragScrollStartTop = 0;

  if (fichaScrollThumb && fichaScrollTrack) {
    fichaScrollThumb.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      isDraggingScrollThumb = true;
      dragScrollStartY = e.clientY;
      dragScrollStartTop = fichaScrollCol.scrollTop;
      fichaScrollThumb.classList.add('is-dragging');
      try {
        fichaScrollThumb.setPointerCapture(e.pointerId);
      } catch {}
    });

    fichaScrollThumb.addEventListener('pointermove', (e) => {
      if (!isDraggingScrollThumb) return;
      const deltaY = e.clientY - dragScrollStartY;
      const trackHeight = fichaScrollTrack.clientHeight;
      const thumbHeight = fichaScrollThumb.clientHeight;
      const maxThumbMove = trackHeight - thumbHeight;
      const maxScroll = fichaScrollCol.scrollHeight - fichaScrollCol.clientHeight;
      if (maxThumbMove > 0 && maxScroll > 0) {
        fichaScrollCol.scrollTop = dragScrollStartTop + (deltaY / maxThumbMove) * maxScroll;
      }
    });

    const stopThumbDrag = (e: PointerEvent) => {
      if (!isDraggingScrollThumb) return;
      isDraggingScrollThumb = false;
      fichaScrollThumb.classList.remove('is-dragging');
      try {
        fichaScrollThumb.releasePointerCapture(e.pointerId);
      } catch {}
    };

    fichaScrollThumb.addEventListener('pointerup', stopThumbDrag);
    fichaScrollThumb.addEventListener('pointercancel', stopThumbDrag);

    fichaScrollTrack.addEventListener('click', (e) => {
      if (e.target === fichaScrollThumb) return;
      const trackRect = fichaScrollTrack.getBoundingClientRect();
      const clickY = e.clientY - trackRect.top;
      const trackHeight = trackRect.height;
      const scrollProgress = Math.max(0, Math.min(1, clickY / trackHeight));
      const maxScroll = fichaScrollCol.scrollHeight - fichaScrollCol.clientHeight;
      fichaScrollCol.scrollTo({
        top: scrollProgress * maxScroll,
        behavior: 'smooth',
      });
    });
  }

  // ================= EVENTOS DE INTERACCIÓN =================
  btnPrev.addEventListener('click', () => stepBy(-1));
  btnNext.addEventListener('click', () => stepBy(1));
  openFichaBtn.addEventListener('click', () => openFicha(openFichaBtn));
  closeFichaBtn.addEventListener('click', () => closeFicha());
  fichaPrevBookBtn.addEventListener('click', () => switchBookInsideFicha(-1));
  fichaNextBookBtn.addEventListener('click', () => switchBookInsideFicha(1));

  for (const btn of yearTabBtns) {
    btn.addEventListener('click', () => {
      const targetYear = Number(btn.dataset.year);
      const currentBook = books[activeBookIndex];
      const preferredMonth = currentBook ? 1 : 1;
      const found =
        books.findIndex((b) => b.year === targetYear && b.month === preferredMonth) !== -1
          ? books.findIndex((b) => b.year === targetYear && b.month === preferredMonth)
          : books.findIndex((b) => b.year === targetYear);
      if (found !== -1) jumpToBookIndex(found);
    });
  }

  for (const tick of monthTickBtns) {
    tick.addEventListener('click', () => {
      const targetMonth = Number(tick.dataset.month);
      const currentYear = books[activeBookIndex]?.year ?? books[0]?.year;
      const found = books.findIndex((b) => b.year === currentYear && b.month === targetMonth);
      if (found !== -1) jumpToBookIndex(found);
    });
  }

  // Clic y teclado accesible (Enter / Space) en lomo cerrado o portada central activa
  function activateSlot(slot: VirtualSlot) {
    const posMod = ((currentPos % M) + M) % M;
    const d = (((slot.vIndex - posMod) % M) + M + M * 0.5) % M - M * 0.5;
    if (Math.abs(d) < 0.38) {
      openFicha(slot.el);
    } else {
      targetPos = Math.round(currentPos + d);
    }
  }

  for (const slot of slots) {
    slot.el.addEventListener('click', (e) => {
      if (pointerMovedPx > 8) {
        e.preventDefault();
        return;
      }
      activateSlot(slot);
    });

    if (slot.el.getAttribute('role') === 'button') {
      slot.el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          activateSlot(slot);
        } else if (e.key === ' ') {
          e.preventDefault();
        }
      });

      slot.el.addEventListener('keyup', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          activateSlot(slot);
        }
      });

      slot.el.addEventListener('focus', () => {
        if (!isDragging && !isFichaOpen && slot.el.matches(':focus-visible')) {
          jumpToBookIndex(slot.bookIndex);
        }
      });
    }
  }

  // Arrastre (Ratón y Táctil) en la estantería
  shelfStage.addEventListener('pointerdown', (e) => {
    if (isFichaOpen) return;
    if ((e.target as HTMLElement).closest('.nav-arrow')) return;
    if (e.button !== 0 && e.pointerType === 'mouse') return;

    isDragging = true;
    activePointerId = e.pointerId;
    dragStartX = e.clientX;
    dragStartPos = targetPos;
    pointerMovedPx = 0;
    lastPointerX = e.clientX;
    lastPointerTime = performance.now();
    pointerVelocityIdx = 0;
  });

  window.addEventListener(
    'pointermove',
    (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      pointerSeen = true;

      if (isDragging && e.pointerId === activePointerId) {
        const dx = e.clientX - dragStartX;
        pointerMovedPx = Math.max(pointerMovedPx, Math.abs(dx));

        const now = performance.now();
        const dtMs = Math.max(now - lastPointerTime, 4);
        const stepDx = e.clientX - lastPointerX;
        const pxPerBook = Math.max(avgPitchPx * 1.65, 68);
        const instantVel = (-stepDx / pxPerBook) / (dtMs / 1000);
        pointerVelocityIdx = pointerVelocityIdx * 0.65 + instantVel * 0.35;

        lastPointerX = e.clientX;
        lastPointerTime = now;

        if (pointerMovedPx > 4) {
          targetPos = dragStartPos - dx / pxPerBook;
        }
      }

      if (!hasFinePointer) return;

      // Detección de estado del cursor e inclinación magnética hacia la portada activa
      const targetEl = e.target as HTMLElement | null;
      if (isFichaOpen) {
        targetTiltX = 0;
        targetTiltY = 0;
        const isText = targetEl?.closest('input, textarea, [contenteditable="true"]');
        if (isText) {
          customCursor.style.opacity = '0';
          return;
        } else {
          customCursor.style.opacity = '1';
        }
        setCursorMode(targetEl?.closest('[data-cursor="compact"], button, a') ? 'compact' : 'default');
        return;
      }

      customCursor.style.opacity = '1';

      if (isDragging && pointerMovedPx > 5) {
        targetTiltX = 0;
        targetTiltY = 0;
        setCursorMode('compact');
        return;
      }

      if (targetEl?.closest('[data-cursor="compact"]')) {
        targetTiltX = 0;
        targetTiltY = 0;
        setCursorMode('compact');
        return;
      }

      const hoveredSlotEl = targetEl?.closest<HTMLElement>('.book-slot');
      if (hoveredSlotEl) {
        const vIdx = Number(hoveredSlotEl.dataset.virtualIndex ?? 0);
        const posMod = ((currentPos % M) + M) % M;
        const d = (((vIdx - posMod) % M) + M + M * 0.5) % M - M * 0.5;
        if (Math.abs(d) < 0.42) {
          setCursorMode('cover');
          const frontRect = hoveredSlotEl
            .querySelector('.book-face--front')
            ?.getBoundingClientRect();
          if (frontRect && frontRect.width > 0 && frontRect.height > 0) {
            const nx = ((e.clientX - (frontRect.left + frontRect.width * 0.5)) / (frontRect.width * 0.5));
            const ny = ((e.clientY - (frontRect.top + frontRect.height * 0.5)) / (frontRect.height * 0.5));
            const tiltFactor = prefersReducedMotion ? 0.25 : 1;
            targetTiltY = Math.max(-1, Math.min(1, nx)) * 9.5 * tiltFactor;
            targetTiltX = Math.max(-1, Math.min(1, -ny)) * 7.5 * tiltFactor;
          }
          return;
        }
        targetTiltX = 0;
        targetTiltY = 0;
        setCursorMode('compact');
        return;
      }

      targetTiltX = 0;
      targetTiltY = 0;
      setCursorMode('default');
    },
    { passive: true }
  );

  function finishDrag(e: PointerEvent) {
    if (!isDragging || e.pointerId !== activePointerId) return;
    isDragging = false;
    activePointerId = null;

    if (pointerMovedPx > 6) {
      const momentum = Math.max(-4.5, Math.min(4.5, pointerVelocityIdx * 0.16));
      targetPos = Math.round(targetPos + momentum);
    }
  }

  window.addEventListener('pointerup', finishDrag);
  window.addEventListener('pointercancel', finishDrag);

  // Rueda del ratón (scroll vertical u horizontal gobierna la estantería)
  window.addEventListener(
    'wheel',
    (e) => {
      if (isFichaOpen) return;
      e.preventDefault();
      const dominantDelta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      const normalized = Math.max(-140, Math.min(140, dominantDelta));
      targetPos += normalized / 210;

      if (wheelSnapTimer !== null) {
        window.clearTimeout(wheelSnapTimer);
      }
      wheelSnapTimer = window.setTimeout(() => {
        targetPos = Math.round(targetPos);
      }, 135);
    },
    { passive: false }
  );

  // Teclado: ArrowLeft / ArrowRight, Enter y Escape
  window.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement | null;
    const active = document.activeElement as HTMLElement | null;
    const isEditingText =
      (target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable ||
          target.closest('.review-form') !== null)) ||
      (active &&
        (active.tagName === 'INPUT' ||
          active.tagName === 'TEXTAREA' ||
          active.isContentEditable ||
          active.closest('.review-form') !== null));

    if (isFichaOpen) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeFicha();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        // Si el usuario está escribiendo o interactuando en la sección "DEJA UN COMENTARIO",
        // no cambiar de libro para que las flechas muevan el cursor de texto normalmente.
        if (isEditingText) {
          return;
        }
        e.preventDefault();
        if (e.key === 'ArrowLeft') {
          switchBookInsideFicha(-1);
        } else {
          switchBookInsideFicha(1);
        }
      }
      return;
    }

    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      if (isEditingText) {
        return;
      }
      e.preventDefault();
      if (e.key === 'ArrowLeft') {
        stepBy(-1);
      } else {
        stepBy(1);
      }
    } else if (e.key === 'Enter') {
      if (isEditingText) {
        return;
      }
      const activeEl = document.activeElement as HTMLElement | null;
      if (
        !activeEl ||
        activeEl === document.body ||
        activeEl.classList.contains('book-slot')
      ) {
        e.preventDefault();
        openFicha(findActiveVirtualSlot().el);
      }
    }
  });

  // Botón de acción circular: respuesta elástica en hover vía WAAPI
  openFichaBtn.addEventListener('pointerenter', () => {
    if (prefersReducedMotion) return;
    openFichaBtn.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.09)' }], {
      duration: 240,
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fill: 'forwards',
    });
  });
  openFichaBtn.addEventListener('pointerleave', () => {
    if (prefersReducedMotion) return;
    openFichaBtn.animate([{ transform: 'scale(1.09)' }, { transform: 'scale(1)' }], {
      duration: 240,
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fill: 'forwards',
    });
  });

  // ================= ÚNICO BUCLE MAESTRO requestAnimationFrame =================
  let rafId: number | null = null;
  let isLoopRunning = false;
  let lastFrameTime = performance.now();

  function startLoop() {
    if (isLoopRunning) return;
    isLoopRunning = true;
    lastFrameTime = performance.now();
    rafId = requestAnimationFrame(masterLoop);
  }

  function stopLoop() {
    isLoopRunning = false;
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  function masterLoop(now: number) {
    if (!isLoopRunning) return;

    const dt = Math.min(Math.max((now - lastFrameTime) / 1000, 0.001), 0.05);
    lastFrameTime = now;

    // 1. Física de resorte de la estantería
    const stiffness = isDragging ? 310 : prefersReducedMotion ? 280 : 155;
    const damping = isDragging ? 32 : prefersReducedMotion ? 34 : 21.5;
    const prevPos = currentPos;

    const springForce = (targetPos - currentPos) * stiffness - velocity * damping;
    velocity += springForce * dt;
    currentPos += velocity * dt;

    if (!isDragging && Math.abs(targetPos - currentPos) < 0.0004 && Math.abs(velocity) < 0.0004) {
      currentPos = targetPos;
      velocity = 0;
    }

    // Detectar cambio de ejemplar activo en el centro exacto
    const nearestBookIdx = (((Math.round(currentPos) % N) + N) % N);
    if (nearestBookIdx !== activeBookIndex && !isFichaOpen) {
      const dir = currentPos >= prevPos ? 1 : -1;
      updateActiveBookUI(nearestBookIdx, dir);
    }

    // 2. Suavizado exponencial de la inclinación magnética de la portada activa
    const tiltLerp = 1 - Math.exp(-14 * dt);
    currentTiltX += (targetTiltX - currentTiltX) * tiltLerp;
    currentTiltY += (targetTiltY - currentTiltY) * tiltLerp;

    // Pose 3D del ejemplar central según la fase de la ficha:
    // - 'pages': gira mostrando el canto derecho de las páginas mientras la ficha sale o entra entre ellas
    // - 'cover': se centra frente al lector para presentar o recibir la ficha sobre su portada
    const targetPoseX = fichaBookPose === 'pages' ? -coverW * 0.2 : 0;
    const targetPoseY = fichaBookPose === 'pages' ? 6 : fichaBookPose === 'cover' ? 4 : 0;
    const targetPoseZ = fichaBookPose === 'pages' ? 16 : fichaBookPose === 'cover' ? 28 : 0;
    const targetPoseRotX = fichaBookPose === 'pages' ? -3.5 : fichaBookPose === 'cover' ? 3.2 : 0;
    const targetPoseRotY = fichaBookPose === 'pages' ? -41.5 : fichaBookPose === 'cover' ? -19.5 : 0;
    const targetPoseRotZ = fichaBookPose === 'pages' ? 2.0 : fichaBookPose === 'cover' ? 4.5 : 0;

    const poseLerp = 1 - Math.exp(-11 * dt);
    fichaPoseX += (targetPoseX - fichaPoseX) * poseLerp;
    fichaPoseY += (targetPoseY - fichaPoseY) * poseLerp;
    fichaPoseZ += (targetPoseZ - fichaPoseZ) * poseLerp;
    fichaPoseRotX += (targetPoseRotX - fichaPoseRotX) * poseLerp;
    fichaPoseRotY += (targetPoseRotY - fichaPoseRotY) * poseLerp;
    fichaPoseRotZ += (targetPoseRotZ - fichaPoseRotZ) * poseLerp;

    // 3. Acordeón trigonométrico 3D e iluminación física de lomos
    const posMod = ((currentPos % M) + M) % M;
    const i0 = Math.floor(posMod);
    const frac = posMod - i0;
    const i1 = (i0 + 1) % M;
    const stepCenter = 0.5 * slotWidths[i0] + 0.5 * slotWidths[i1];
    const interpCenterPx = cumCenters[i0] + frac * stepCenter;

    const accordionSpread = coverW * 0.58 + (viewportW < 640 ? 18 : 34);
    const cullLimitPx = viewportW * 0.65 + coverW;
    const openRadius = 1.12;
    let centerOpenFactor = 0;

    for (let v = 0; v < M; v++) {
      const slot = slots[v];
      const d = (((v - posMod) % M) + M + M * 0.5) % M - M * 0.5;
      const absD = Math.abs(d);

      // Distancia lineal exacta considerando el grosor individual de cada libro
      const rawDx = cumCenters[v] - interpCenterPx;
      const xLinear =
        (((rawDx % totalSpanPx) + totalSpanPx + totalSpanPx * 0.5) % totalSpanPx) -
        totalSpanPx * 0.5;

      // Campana trigonométrica (Hann / coseno alzado) para apertura del libro central
      const open =
        absD < openRadius ? 0.5 * (1 + Math.cos((Math.PI * absD) / openRadius)) : 0;

      if (absD < 0.55 && open > centerOpenFactor) {
        centerOpenFactor = open;
      }

      // Desplazamiento de acordeón trigonométrico para empujar suavemente a los vecinos
      const sign = d < 0 ? -1 : 1;
      const primaryPush =
        absD === 0
          ? 0
          : sign * Math.sin(Math.min(absD, 1.0) * (Math.PI * 0.5)) * accordionSpread;
      const harmonicRipple =
        absD === 0
          ? 0
          : sign *
            Math.sin(Math.min(absD, 6.0) * (Math.PI / 6.0)) *
            (accordionSpread * 0.13) *
            Math.exp(-absD * 0.22);

      const x = xLinear + primaryPush + harmonicRipple + open * fichaPoseX;

      // Descarte (culling) de copias fuera de pantalla para mantener 120fps constantes
      if (Math.abs(x) > cullLimitPx) {
        if (slot.lastVisible) {
          slot.el.style.visibility = 'hidden';
          slot.lastVisible = false;
        }
        continue;
      }
      if (!slot.lastVisible) {
        slot.el.style.visibility = 'visible';
        slot.lastVisible = true;
      }

      // Elevación, acercamiento Z, giro 3D de lomo a portada e inclinación editorial de -4.5°
      const y = -18 * open + open * fichaPoseY;
      const z =
        (1 - open) * (-coverW * 0.5 - Math.min(absD, 14) * 2.8) +
        open * (84 + fichaPoseZ);

      const neighborLeanZ =
        sign * Math.sin(Math.min(absD, 3.0) * (Math.PI / 3.0)) * 1.6 * (1 - open);

      const rotY = (1 - open) * 90 + open * (19.5 + currentTiltY + fichaPoseRotY);
      const rotZ = neighborLeanZ + open * (-4.5 + currentTiltY * 0.08 + fichaPoseRotZ);
      const rotX = (1 - open) * -0.6 + open * (-3.2 + currentTiltX + fichaPoseRotX);

      slot.el.style.zIndex = String(Math.round(500 - absD * 10 + open * 300));
      slot.el.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, ${z.toFixed(2)}px)`;
      slot.book3d.style.transform = `rotateZ(${rotZ.toFixed(2)}deg) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;

      // Control óptico de reflejos: difuminado suave y eliminación de traslapes
      if (open > 0.01) {
        if (slot.lastFrontDisp !== 'block') {
          slot.reflFront.style.display = 'block';
          slot.lastFrontDisp = 'block';
        }
        slot.reflFront.style.opacity = (open * 0.55).toFixed(2);

        const spineDisp = open > 0.85 ? 'none' : 'block';
        if (slot.lastSpineDisp !== spineDisp) {
          slot.reflSpine.style.display = spineDisp;
          slot.lastSpineDisp = spineDisp;
        }

        slot.reflWrap.style.transform = `translateY(${(36 * open).toFixed(2)}px)`;
      } else {
        if (slot.lastFrontDisp !== 'none') {
          slot.reflFront.style.display = 'none';
          slot.lastFrontDisp = 'none';
        }
        if (slot.lastSpineDisp !== 'block') {
          slot.reflSpine.style.display = 'block';
          slot.lastSpineDisp = 'block';
        }
        if (slot.reflWrap.style.transform) {
          slot.reflWrap.style.transform = '';
        }
      }

      // Atenuación suave de reflejos de lomos vecinos traslapados tras la portada abierta
      const neighborDim = absD < 1.1 ? Math.max(0, (absD - 0.35) / 0.75) : 1;
      const spineOp = (0.5 * neighborDim).toFixed(2);
      if (slot.lastSpineOp !== spineOp) {
        slot.reflSpine.style.opacity = spineOp;
        slot.lastSpineOp = spineOp;
      }

      // Iluminación lambertiana dinámica de lomos + oclusión junto al ejemplar abierto
      const radY = (rotY * Math.PI) / 180;
      const normalX = -Math.cos(radY);
      const normalZ = Math.sin(radY);
      const lambert = Math.max(0, normalX * -0.28 + normalZ * 0.96);
      const aoDip = absD > 0.65 && absD < 1.85 ? (1 - Math.abs(absD - 1.15) / 0.7) * 0.14 : 0;
      const edgeFalloff = Math.min(absD / 16, 1) * 0.12;
      const brightness = Math.max(0.68, Math.min(1.12, 0.76 + lambert * 0.34 - aoDip - edgeFalloff));
      const litStr = brightness.toFixed(2);
      if (litStr !== slot.lastLit) {
        if (brightness < 1) {
          const shade = ((1 - brightness) * 0.78).toFixed(3);
          slot.el.style.setProperty('--spine-light', `rgba(0, 0, 0, ${shade})`);
        } else {
          const tint = ((brightness - 1) * 0.72).toFixed(3);
          slot.el.style.setProperty('--spine-light', `rgba(255, 255, 255, ${tint})`);
        }
        slot.lastLit = litStr;
      }
    }

    // Sombra en el papel escalada según la apertura del ejemplar central
    const shadowScaleX = 0.35 + centerOpenFactor * 0.72;
    const shadowScaleY = 0.56 + centerOpenFactor * 0.54;
    castShadow.style.transform = `translate3d(${(currentTiltY * 0.7).toFixed(1)}px, 0, 0) rotate(-4.5deg) scale(${shadowScaleX.toFixed(3)}, ${shadowScaleY.toFixed(3)})`;

    // 4. Cursor personalizado con suavizado exponencial (sin transiciones de opacidad)
    if (hasFinePointer && pointerSeen) {
      const cursorAlpha = 1 - Math.exp(-20 * dt);
      cursorX += (mouseX - cursorX) * cursorAlpha;
      cursorY += (mouseY - cursorY) * cursorAlpha;

      const desiredRing =
        cursorMode === 'cover' ? 0 : cursorMode === 'compact' ? (isDragging ? 0.66 : 0.44) : 1;
      const desiredCobalt = cursorMode === 'cover' ? 1 : 0;

      const morphAlpha = 1 - Math.exp(-16 * dt);
      ringScale += (desiredRing - ringScale) * morphAlpha;
      cobaltScale += (desiredCobalt - cobaltScale) * morphAlpha;

      customCursor.style.transform = `translate3d(${cursorX.toFixed(2)}px, ${cursorY.toFixed(2)}px, 0)`;
      cursorRing.style.transform = `scale(${ringScale.toFixed(3)})`;
      cursorCobaltDisk.style.transform = `scale(${cobaltScale.toFixed(3)})`;
    }

    rafId = requestAnimationFrame(masterLoop);
  }

  // Suspender el ciclo de animación cuando la pestaña esté oculta para no consumir CPU/GPU
  // y reanudarlo con un cuadro de tiempo limpio al volver (evita congelamientos en Firefox/Chromium).
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopLoop();
      isDragging = false;
      activePointerId = null;
      targetTiltX = 0;
      targetTiltY = 0;
      setCursorMode('default');
    } else {
      startLoop();
    }
  });

  window.addEventListener('blur', () => {
    isDragging = false;
    activePointerId = null;
    targetTiltX = 0;
    targetTiltY = 0;
    setCursorMode('default');
  });

  measureGeometry();
  document.fonts?.ready.then(() => measureGeometry());
  const resizeObserver = new ResizeObserver(() => measureGeometry());
  resizeObserver.observe(document.documentElement);
  resizeObserver.observe(sizeProbe);

  startLoop();
</script>
