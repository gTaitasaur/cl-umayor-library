---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'libros'>[];
}

const { entries } = Astro.props;

const renderedBooks = entries.map((entry, index) => ({
  index,
  slug: entry.slug,
  data: entry.data,
}));

const years = Array.from(new Set(renderedBooks.map((b) => b.data.year))).sort((a, b) => a - b);
const monthCodes = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const totalEditions = renderedBooks.length;

function buildEditorialTitleLayout(rawTitle: string): {
  lines: string[];
  fontSize: number;
  yPositions: number[];
} {
  const upper = rawTitle.trim().toLocaleUpperCase('es-CL');
  const words = upper.split(/\s+/).filter(Boolean);
  const maxCharsPerLine = 15;

  let lines: string[] = [];
  if (upper.length <= maxCharsPerLine) {
    lines = [upper];
  } else {
    let current = '';
    for (const word of words) {
      const candidate = current ? `${current} ${word}` : word;
      if (candidate.length <= maxCharsPerLine || !current) {
        current = candidate;
      } else {
        lines.push(current);
        current = word;
      }
    }
    if (current) lines.push(current);
  }

  let baseFontSize = 42;
  let lineHeight = 42;
  if (lines.length === 2) {
    baseFontSize = 35;
    lineHeight = 37;
  } else if (lines.length === 3) {
    baseFontSize = 30;
    lineHeight = 32;
  } else if (lines.length >= 4) {
    lines = [];
    let current = '';
    for (const word of words) {
      const candidate = current ? `${current} ${word}` : word;
      if (candidate.length <= 19 || !current) {
        current = candidate;
      } else {
        lines.push(current);
        current = word;
      }
    }
    if (current) lines.push(current);
    baseFontSize = lines.length >= 4 ? 24 : 28;
    lineHeight = lines.length >= 4 ? 27 : 31;
  }

  const longestLine = Math.max(...lines.map((l) => l.length), 1);
  const maxSafeFontSize = Math.floor(510 / (longestLine * 0.64));
  const fontSize = Math.min(baseFontSize, maxSafeFontSize);

  let yPositions: number[];
  if (lines.length === 1) {
    yPositions = [178];
  } else if (lines.length === 2 && fontSize === 35) {
    yPositions = [158, 195];
  } else if (lines.length === 3 && fontSize === 30) {
    yPositions = [146, 178, 210];
  } else {
    const centerBaseline = 178;
    const startY = centerBaseline - ((lines.length - 1) * lineHeight) / 2;
    yPositions = lines.map((_, i) => Math.round(startY + i * lineHeight));
  }

  return { lines, fontSize, yPositions };
}

const booksPayload = renderedBooks.map((b) => {
  const resolvedCover = b.data.coverImage ?? b.data.cover ?? '/covers/cover-01.svg';
  const editorialAccent = b.data.accentColor ?? (b.index % 2 === 0 ? '#1F3FB0' : '#B8332A');
  const computedThickness =
    b.data.thickness ?? Math.round(Math.min(82, Math.max(46, 38 + b.data.pages * 0.068)));

  const titleLength = b.data.title.trim().length;
  const titleTier =
    titleLength <= 17
      ? 'short'
      : titleLength <= 25
        ? 'medium'
        : titleLength <= 31
          ? 'long'
          : 'xlong';

  return {
    index: b.index,
    slug: b.slug,
    title: b.data.title,
    titleTier,
    author: b.data.author,
    year: b.data.year,
    month: b.data.month,
    monthCode: (b.data.monthShort ?? monthCodes[b.data.month - 1] ?? 'MES').toUpperCase(),
    monthName: b.data.monthName,
    cover: resolvedCover,
    spineImage: b.data.spineImage ?? null,
    spineColor: b.data.spineColor,
    spineTextColor: b.data.spineTextColor,
    accentColor: editorialAccent,
    thickness: computedThickness,
    pages: b.data.pages,
    genre: b.data.genre,
    rating: b.data.rating ?? '—',
    publisher: b.data.publisher?.trim() ?? null,
    publishedYear: b.data.publishedYear ?? null,
    country: b.data.country ?? null,
    synopsis: b.data.synopsis,
  };
});

const editorialCoverSpecs = renderedBooks.map((b) => {
  const payload = booksPayload[b.index];
  const authorUpper = b.data.author.trim().toLocaleUpperCase('es-CL');
  const isLongAuthor = authorUpper.length > 28;

  return {
    index: b.index,
    cover: payload.cover,
    coverMode: b.data.coverMode ?? 'editorial',
    coverFit: b.data.coverFit ?? 'contain',
    coverFrameBg: b.data.coverFrameBg ?? '#141414',
    editorialAccent: payload.accentColor,
    titleLayout: buildEditorialTitleLayout(b.data.title),
    authorUpper,
    authorFontSize: isLongAuthor ? 11.5 : 13,
    authorLetterSpacing: isLongAuthor ? 1.8 : 2.6,
    metaLine: `${b.data.genre} · ${b.data.pages} págs.`,
    editionLabel: `EDICIÓN N.º ${String(b.index + 1).padStart(2, '0')} / ${String(totalEditions).padStart(2, '0')}`,
    badgeLabel: `[${payload.monthCode} · ${b.data.year}]`,
  };
});

// 3 ciclos virtuales garantizan una estantería infinita sin costuras incluso en monitores 4K ultrawide
const VIRTUAL_COPIES = [0, 1, 2];
const initialIndex = Math.max(0, booksPayload.length - 1);
const initialBook = booksPayload[initialIndex];
---

<!-- Filtros y Plantillas Editoriales SVG globales (1 símbolo vectorial por libro, reutilizado en 3D, reflejo y ficha) -->
<svg class="svg-defs-global" aria-hidden="true" width="0" height="0">
  <defs>
    <pattern id="silkscreen-dots-editorial" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="0.55" fill="#141414" fill-opacity="0.09" />
      <circle cx="4.5" cy="4.5" r="0.45" fill="#141414" fill-opacity="0.06" />
    </pattern>

    <filter id="paper-tooth-filter" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.82"
        numOctaves="3"
        seed="4"
        stitchTiles="stitch"
        result="grain"
      />
      <feColorMatrix type="saturate" values="0" in="grain" result="monoGrain" />
      <feComponentTransfer in="monoGrain">
        <feFuncR type="linear" slope="0.25" intercept="0.05" />
        <feFuncG type="linear" slope="0.22" intercept="0.04" />
        <feFuncB type="linear" slope="0.18" intercept="0.03" />
        <feFuncA type="linear" slope="0.075" intercept="0" />
      </feComponentTransfer>
    </filter>
  </defs>

  {editorialCoverSpecs.map((spec) => (
    <symbol id={`editorial-cover-${spec.index}`} viewBox="0 0 648 900">
      {spec.coverMode === 'full' ? (
        <image
          href={spec.cover}
          x="0"
          y="0"
          width="648"
          height="900"
          preserveAspectRatio="xMidYMid slice"
        />
      ) : (
        <>
          {/* Papel base serigráfico crema */}
          <rect width="648" height="900" fill="#EDEBE6" />
          <rect width="648" height="900" fill="url(#silkscreen-dots-editorial)" />

          {/* Marco fino editorial Criterion / Vasari */}
          <rect x="24" y="22" width="600" height="856" fill="none" stroke="#141414" stroke-width="1.5" />
          <rect
            x="31"
            y="28"
            width="586"
            height="844"
            fill="none"
            stroke="#141414"
            stroke-width="0.6"
            stroke-opacity="0.45"
          />

          {/* Leyenda superior con alternancia automática Azul (#1F3FB0) / Rojo (#B8332A) */}
          <text
            x="324"
            y="64"
            text-anchor="middle"
            font-family="system-ui, -apple-system, sans-serif"
            font-weight="700"
            font-size="10.5"
            letter-spacing="3.2"
            fill={spec.editorialAccent}
          >SELECCIÓN DEL CLUB DE LECTURA</text>
          <line x1="72" y1="80" x2="576" y2="80" stroke="#141414" stroke-width="1.2" />

          {/* Título grande en serif condensada (ajuste dinámico en 1, 2, 3 o 4 líneas) */}
          {spec.titleLayout.lines.map((line, lineIdx) => (
            <text
              x="0"
              y="0"
              text-anchor="middle"
              font-family="Georgia, 'Times New Roman', serif"
              font-weight="700"
              font-size={spec.titleLayout.fontSize}
              letter-spacing="-0.5"
              transform={`translate(324, ${spec.titleLayout.yPositions[lineIdx]}) scale(0.98, 1.04)`}
              fill="#141414"
            >{line}</text>
          ))}

          {/* Autor y metadato editorial */}
          <line x1="244" y1="262" x2="404" y2="262" stroke={spec.editorialAccent} stroke-width="2" />
          <text
            x="324"
            y="290"
            text-anchor="middle"
            font-family="system-ui, -apple-system, sans-serif"
            font-weight="600"
            font-size={spec.authorFontSize}
            letter-spacing={spec.authorLetterSpacing}
            fill="#141414"
          >{spec.authorUpper}</text>
          <text
            x="324"
            y="314"
            text-anchor="middle"
            font-family="Georgia, serif"
            font-style="italic"
            font-size="13"
            fill="#141414"
            fill-opacity="0.72"
          >{spec.metaLine}</text>

          {/* Ventana central vertical en formato 4:5 (352 × 440 px) */}
          <svg x="148" y="338" width="352" height="440" viewBox="0 0 352 440" overflow="hidden">
            <rect width="352" height="440" fill={spec.coverFrameBg} />
            <image
              href={spec.cover}
              x="0"
              y="0"
              width="352"
              height="440"
              preserveAspectRatio={spec.coverFit === 'cover' ? 'xMidYMid slice' : 'xMidYMid meet'}
            />
          </svg>
          <rect x="148" y="338" width="352" height="440" fill="none" stroke="#141414" stroke-width="1.5" />

          {/* Pie editorial e insignia enmarcada inferior derecha */}
          <text
            x="72"
            y="832"
            font-family="system-ui, -apple-system, sans-serif"
            font-weight="600"
            font-size="9.5"
            letter-spacing="2"
            fill="#141414"
            fill-opacity="0.72"
          >{spec.editionLabel}</text>

          <g transform="translate(458, 810)">
            <rect x="0" y="0" width="118" height="32" fill="#141414" />
            <rect x="3" y="3" width="112" height="26" fill="none" stroke="#EDEBE6" stroke-width="0.8" />
            <text
              x="59"
              y="20"
              text-anchor="middle"
              font-family="ui-monospace, monospace"
              font-weight="700"
              font-size="11"
              letter-spacing="1.4"
              fill="#EDEBE6"
            >{spec.badgeLabel}</text>
          </g>
        </>
      )}
    </symbol>
  ))}
</svg>

<div class="stage-root" id="stage-root">
  <!-- Textura de grano de papel impreso -->
  <svg class="paper-grain-layer" aria-hidden="true" width="100%" height="100%">
    <rect width="100%" height="100%" filter="url(#paper-tooth-filter)"></rect>
  </svg>

  <!-- Marcas de registro editorial en las esquinas -->
  <div class="corner-mark corner-mark--tl" aria-hidden="true"></div>
  <div class="corner-mark corner-mark--tr" aria-hidden="true"></div>
  <div class="corner-mark corner-mark--bl" aria-hidden="true"></div>
  <div class="corner-mark corner-mark--br" aria-hidden="true"></div>

  <!-- Cabecera Editorial y Pestañas de Año / Mes -->
  <header class="stage-header">
    <div class="brand-block">
      <a href="/" class="brand-link" aria-label="Club de Lectura UM, Temuco">
        <img
          src="/logo.svg"
          alt="Emblema Club de Lectura UM"
          class="brand-logo"
          width="44"
          height="44"
          loading="eager"
          decoding="async"
        />
        <div class="brand-text-stack">
          <h1 class="brand-title">Club de Lectura UM</h1>
          <span class="brand-kicker">TEMUCO</span>
        </div>
      </a>
    </div>

    <div class="chronology-controls">
      <nav class="year-nav" aria-label="Temporadas por año">
        <div class="year-tabs" id="year-tabs">
          {
            years.map((yr) => (
              <button
                type="button"
                class="year-tab"
                data-year={yr}
                aria-pressed={initialBook && yr === initialBook.year ? 'true' : 'false'}
                data-cursor="compact"
              >
                <span class="year-tab-label">{yr}</span>
              </button>
            ))
          }
          <span class="year-active-bar" id="year-active-bar" aria-hidden="true"></span>
        </div>
      </nav>

      <nav class="month-strip" aria-label="Meses del año activo">
        {
          monthCodes.map((code, mIdx) => {
            const isInitialMonth = initialBook && mIdx + 1 === initialBook.month;
            return (
              <button
                type="button"
                class={`month-tick ${isInitialMonth ? 'is-active' : ''}`}
                data-month={mIdx + 1}
                aria-label={`Ir a mes ${code}`}
                aria-current={isInitialMonth ? 'true' : undefined}
                data-cursor="compact"
              >
                <span class="month-tick-bar" aria-hidden="true" />
                <span class="month-tick-code">{code}</span>
              </button>
            );
          })
        }
      </nav>
    </div>

    <div class="archive-status" aria-live="polite" aria-atomic="true">
      <div class="folio-counter">
        <span class="folio-prefix">TÍTULO</span>
        <span class="folio-num-wrap">
          <span class="mask-slot folio-slot" id="counter-index-slot">
            <span class="mask-item">{String(initialIndex + 1).padStart(2, '0')}</span>
          </span>
          <span class="folio-sep">/</span>
          <span class="folio-total">{String(booksPayload.length).padStart(2, '0')}</span>
        </span>
      </div>
      <span class="controls-hint">ARRASTRAR · RUEDA · TECLADO ← →</span>
    </div>
  </header>

  <!-- Escenario Central 3D: Estantería Horizontal Infinita -->
  <main class="shelf-stage" id="shelf-stage" aria-label="Estantería interactiva 3D del Club de Lectura">
    <!-- Sonda invisible para medir variables CSS responsivas con exactitud subpíxel -->
    <div class="book-size-probe" id="book-size-probe" aria-hidden="true"></div>

    <!-- Línea arquitectónica de apoyo de estantería -->
    <div class="shelf-horizon-rule" aria-hidden="true"></div>

    <!-- Flechas Laterales de Navegación -->
    <button
      type="button"
      class="nav-arrow nav-arrow--prev"
      id="btn-prev"
      aria-label="Libro anterior"
      data-cursor="compact"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path
          d="M15 5L8 12L15 19"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      class="nav-arrow nav-arrow--next"
      id="btn-next"
      aria-label="Libro siguiente"
      data-cursor="compact"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path
          d="M9 5L16 12L9 19"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>

    <!-- Escena con perspectiva 3D acelerada por GPU -->
    <div class="shelf-scene" id="shelf-scene">
      <!-- Sombra proyectada sobre el papel bajo el ejemplar activo -->
      <div class="active-cast-shadow" id="active-cast-shadow" aria-hidden="true"></div>

      <div class="shelf-track" id="shelf-track">
        {
          VIRTUAL_COPIES.map((copyIdx) =>
            booksPayload.map((book) => {
              const virtualIndex = copyIdx * booksPayload.length + book.index;
              const isPrimaryCopy = copyIdx === 0;
              return (
                <div
                  class="book-slot"
                  data-virtual-index={virtualIndex}
                  data-book-index={book.index}
                  data-thickness={book.thickness}
                  role={isPrimaryCopy ? 'button' : undefined}
                  aria-label={
                    isPrimaryCopy
                      ? `${book.title}, de ${book.author} (${book.monthName} ${book.year})`
                      : undefined
                  }
                  aria-hidden={isPrimaryCopy ? undefined : 'true'}
                  tabindex={isPrimaryCopy ? 0 : undefined}
                  style={`--spine-bg: ${book.spineColor}; --spine-fg: ${book.spineTextColor}; --book-accent: ${book.accentColor};`}
                >
                  <span class="book-3d">
                    {/* 1. Portada Frontal Editorial Dinámica */}
                    <span class="book-face book-face--front">
                      <svg
                        class="cover-art-img"
                        viewBox="0 0 648 900"
                        preserveAspectRatio="xMidYMid slice"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <use href={`#editorial-cover-${book.index}`} width="648" height="900" />
                      </svg>
                      <span class="cover-hinge-groove" aria-hidden="true" />
                      <span class="cover-paper-sheen" aria-hidden="true" />
                    </span>

                    {/* 2. Lomo Físico Encuadernado */}
                    <span class="book-face book-face--spine">
                      {book.spineImage ? (
                        <img
                          class="spine-custom-img"
                          src={book.spineImage}
                          alt=""
                          draggable="false"
                          decoding="async"
                        />
                      ) : (
                        <span class="spine-editorial" aria-hidden="true">
                          <span class="spine-head">
                            <span class="spine-thumb-frame">
                              <img
                                class="spine-thumb-img"
                                src={book.cover}
                                alt=""
                                draggable="false"
                                decoding="async"
                              />
                            </span>
                            <span class="spine-band" />
                          </span>
                          <span class="spine-body">
                            <span
                              class={`spine-title spine-title--${book.titleTier}`}
                              title={book.title}
                            >
                              {book.title}
                            </span>
                          </span>
                          <span class="spine-foot">
                            <span class="spine-seal">
                              <img
                                class="spine-seal-logo"
                                src="/logo.svg"
                                alt=""
                                width="20"
                                height="20"
                                draggable="false"
                                decoding="async"
                              />
                              <span class="spine-seal-num">{book.index + 1}</span>
                            </span>
                          </span>
                        </span>
                      )}
                      <span class="spine-cloth-weave" aria-hidden="true" />
                    </span>

                    {/* 3. Canto Delantero de Páginas (Derecha) */}
                    <span class="book-face book-face--pages-right" aria-hidden="true" />

                    {/* 4. Canto Superior de Páginas (Cabeza + Cabezada) */}
                    <span class="book-face book-face--pages-top" aria-hidden="true" />

                    {/* 5. Canto Inferior de Páginas (Pie) */}
                    <span class="book-face book-face--pages-bottom" aria-hidden="true" />

                    {/* 6. Contraportada en Tela Editorial */}
                    <span class="book-face book-face--back" aria-hidden="true" />

                    {/* Ficha catalográfica 3D alojada entre las páginas del ejemplar */}
                    <span class="book-face book-catalog-card" aria-hidden="true">
                      <span class="catalog-card-band" />
                      <span class="catalog-card-rules">
                        <span class="catalog-card-rule catalog-card-rule--crimson" />
                        <span class="catalog-card-rule" />
                        <span class="catalog-card-rule" />
                        <span class="catalog-card-rule" />
                        <span class="catalog-card-rule" />
                        <span class="catalog-card-rule catalog-card-rule--short" />
                      </span>
                      <span class="catalog-card-hole" />
                    </span>

                    {/* Sellado interior del lomo contra fugas de luz en ángulos rasantes */}
                    <span class="book-spine-backer" aria-hidden="true" />

                    {/* 7. Reflejos 3D Suaves bajo la Estantería (Lomos y Portada) */}
                    <span class="book-refl-wrap" aria-hidden="true">
                      {/* Reflejo de Portada */}
                      <span class="book-refl--front">
                        <svg
                          class="refl-cover-img"
                          viewBox="0 0 648 900"
                          preserveAspectRatio="xMidYMax slice"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <use href={`#editorial-cover-${book.index}`} width="648" height="900" />
                        </svg>
                        <span class="refl-front-sheen" />
                      </span>

                      {/* Reflejo de Lomo */}
                      <span class="book-refl--spine">
                        {book.spineImage ? (
                          <img
                            class="refl-spine-custom-img"
                            src={book.spineImage}
                            alt=""
                            draggable="false"
                            decoding="async"
                          />
                        ) : (
                          <span class="refl-spine-editorial">
                            <span class="refl-spine-seal">
                              <img
                                class="refl-spine-logo"
                                src="/logo.svg"
                                alt=""
                                width="14"
                                height="14"
                                draggable="false"
                                decoding="async"
                              />
                            </span>
                          </span>
                        )}
                        <span class="refl-spine-cloth" />
                      </span>
                    </span>
                  </span>
                </div>
              );
            })
          )
        }
      </div>
    </div>
  </main>

  <!-- Pie Dinámico con Máscaras Independientes y Botón Circular de Acción -->
  <footer class="stage-footer">
    <div class="caption-stack" aria-live="polite" aria-atomic="true">
      <div class="mask-slot caption-slot caption-slot--title" id="caption-title-slot">
        <span class="mask-item caption-title-text">{initialBook?.title}</span>
      </div>

      <div class="mask-slot caption-slot caption-slot--subtitle" id="caption-subtitle-slot">
        <span class="mask-item caption-subtitle-text">
          {initialBook ? `${initialBook.author.toUpperCase()}${initialBook.publishedYear ? ` · ${initialBook.publishedYear}` : ''}` : ''}
        </span>
      </div>

      <div class="mask-slot caption-slot caption-slot--year" id="caption-year-slot">
        <span class="mask-item caption-year-text">
          {initialBook ? `${initialBook.monthName.toUpperCase()} ${initialBook.year} · ${initialBook.pages} PÁGS.` : ''}
        </span>
      </div>
    </div>

    <div class="footer-action-wrap">
      <button
        type="button"
        class="action-circle-btn"
        id="open-ficha-btn"
        aria-label="Abrir ficha técnica de lectura"
        data-cursor="compact"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path
            d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v17H6.5A2.5 2.5 0 0 0 4 22.5V5.5Zm16 0A2.5 2.5 0 0 0 17.5 3H12v17h5.5a2.5 2.5 0 0 1 2.5 2.5V5.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span class="action-circle-label">FICHA</span>
      </button>
    </div>
  </footer>

  <!-- Colofón de Crédito Editorial (Discreto y Sutil) -->
  <aside class="colophon-credit" aria-label="Crédito de desarrollo">
    <span class="colophon-label">Desarrollo web:</span>
    <a
      href="https://github.com/gTaitasaur"
      target="_blank"
      rel="noopener noreferrer"
      class="colophon-link"
      data-cursor="compact"
      aria-label="Christian en GitHub (abre en pestaña nueva)"
    >
      Christian
    </a>
  </aside>
</div>

<!-- Pliego Desplegable de Ficha Técnica (Hermano de #stage-root para gestión limpia de `inert`) -->
<div
  class="ficha-sheet"
  id="ficha-sheet"
  role="dialog"
  aria-labelledby="ficha-book-title"
  tabindex="-1"
  hidden
>
  <svg class="paper-grain-layer" aria-hidden="true" width="100%" height="100%">
    <rect width="100%" height="100%" filter="url(#paper-tooth-filter)"></rect>
  </svg>

  <!-- Rayado de tarjeta catalográfica visible mientras la ficha entra o sale del ejemplar 3D -->
  <div class="ficha-card-watermark" id="ficha-card-watermark" aria-hidden="true">
    <div class="watermark-top-band"></div>
    <div class="watermark-rules">
      <span class="watermark-rule watermark-rule--crimson"></span>
      <span class="watermark-rule"></span>
      <span class="watermark-rule"></span>
      <span class="watermark-rule"></span>
      <span class="watermark-rule"></span>
      <span class="watermark-rule watermark-rule--short"></span>
    </div>
    <div class="watermark-hole"></div>
  </div>

  <div class="ficha-inner" id="ficha-inner">
    <!-- Barra Superior del Pliego -->
    <div class="ficha-topbar">
      <div class="mask-reveal">
        <div class="mask-reveal-inner ficha-kicker" id="ficha-folio-code">
          REGISTRO · Nº {String(initialIndex + 1).padStart(2, '0')}
        </div>
      </div>

      <button
        type="button"
        class="ficha-close-btn"
        id="close-ficha-btn"
        aria-label="Cerrar ficha de lectura"
        data-cursor="compact"
      >
        <span class="ficha-close-text">CERRAR <span class="ficha-esc-hint">[ESC]</span></span>
        <span class="ficha-close-circle" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="13" height="13">
            <path
              d="M5 5L15 15M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>
      </button>
    </div>

    <div class="ficha-rule-scale" id="ficha-top-rule" aria-hidden="true"></div>

    <!-- Diseño Editorial a Dos Columnas -->
    <div class="ficha-columns">
      <!-- Columna Izquierda: Metadatos, Sinopsis y Notas .md en Máscaras -->
      <div class="ficha-col-left-wrap">
        <div class="ficha-col-left" id="ficha-scroll-col">
        <div class="ficha-header-group">
          <div class="mask-reveal">
            <div class="mask-reveal-inner ficha-season-tag" id="ficha-season-tag"></div>
          </div>

          <div class="mask-reveal">
            <h2 class="mask-reveal-inner ficha-book-title" id="ficha-book-title"></h2>
          </div>

          <div class="mask-reveal">
            <p class="mask-reveal-inner ficha-author-line" id="ficha-author-line"></p>
          </div>
        </div>

        <div class="ficha-rule-scale" aria-hidden="true"></div>

        <!-- Cuadrícula de Metadatos Editoriales -->
        <dl class="ficha-meta-grid">
          <div class="meta-cell">
            <dt class="mask-reveal">
              <span class="mask-reveal-inner meta-dt">MES DE LECTURA</span>
            </dt>
            <dd class="mask-reveal">
              <span class="mask-reveal-inner meta-dd" id="meta-cycle"></span>
            </dd>
          </div>
          <div class="meta-cell">
            <dt class="mask-reveal">
              <span class="mask-reveal-inner meta-dt">FECHA DE PUBLICACIÓN</span>
            </dt>
            <dd class="mask-reveal">
              <span class="mask-reveal-inner meta-dd" id="meta-published"></span>
            </dd>
          </div>
          <div class="meta-cell">
            <dt class="mask-reveal">
              <span class="mask-reveal-inner meta-dt">GÉNERO / EXTENSIÓN</span>
            </dt>
            <dd class="mask-reveal">
              <span class="mask-reveal-inner meta-dd" id="meta-genre"></span>
            </dd>
          </div>
          <div class="meta-cell">
            <dt class="mask-reveal">
              <span class="mask-reveal-inner meta-dt">VALORACIÓN</span>
            </dt>
            <dd class="mask-reveal">
              <span class="mask-reveal-inner meta-dd" id="meta-rating"></span>
            </dd>
          </div>
        </dl>

        <div class="ficha-rule-scale" aria-hidden="true"></div>

        <!-- Sinopsis línea por línea en máscara -->
        <section class="ficha-section" aria-labelledby="heading-synopsis">
          <div class="mask-reveal">
            <h3 class="mask-reveal-inner ficha-section-heading" id="heading-synopsis">
              SINOPSIS
            </h3>
          </div>
          <div class="ficha-synopsis-lines" id="ficha-synopsis-lines"></div>
        </section>

        <!-- Línea superior animada de navegación -->
        <div class="ficha-rule-scale ficha-nav-rule-top" aria-hidden="true"></div>

        <!-- Navegación entre meses desde dentro del pliego (Inmediatamente debajo de la Sinopsis) -->
        <nav class="ficha-sheet-nav" aria-label="Navegación entre meses del catálogo">
          <button
            type="button"
            class="sheet-step-btn"
            id="ficha-prev-book"
            data-cursor="compact"
          >
            <span class="mask-reveal">
              <span class="mask-reveal-inner">← MES ANTERIOR</span>
            </span>
          </button>
          <button
            type="button"
            class="sheet-step-btn"
            id="ficha-next-book"
            data-cursor="compact"
          >
            <span class="mask-reveal">
              <span class="mask-reveal-inner">MES SIGUIENTE →</span>
            </span>
          </button>
        </nav>

        <!-- Línea inferior animada de navegación -->
        <div class="ficha-rule-scale ficha-nav-rule-bottom" aria-hidden="true"></div>

        <!-- Sección de Opiniones y Calificación de los Miembros del Club -->
        <section class="ficha-section ficha-reviews-section" aria-label="Opinión de Lectores">
          <!-- Formulario Editorial Compacto para registrar comentario y calificación -->
          <form
            class="review-form"
            id="review-form"
            novalidate
            autocomplete="off"
            data-bwignore="true"
            data-1p-ignore="true"
            data-lpignore="true"
            data-form-type="other"
          >
            <!-- Honeypot invisible para humanos (Trampa de seguridad anti-bot) -->
            <div
              class="review-hp-trap"
              aria-hidden="true"
              style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; z-index: -1;"
            >
              <label for="review-hp-security-check">Por favor deja este campo vacío</label>
              <input
                type="text"
                id="review-hp-security-check"
                name="hp_security_check"
                tabindex="-1"
                autocomplete="off"
                data-bwignore="true"
                data-1p-ignore="true"
                data-lpignore="true"
                value=""
              />
            </div>

            <div class="mask-reveal review-form-mask">
              <div class="mask-reveal-inner">
                <div class="review-form-card">
                  <div class="review-form-header">
                    <span class="review-form-title">DEJA UN COMENTARIO</span>
                  </div>

                  <!-- Fila: Nombre y Correo -->
                  <div class="review-form-row">
                    <div class="review-field field-name">
                      <label for="review-author-name" class="review-label">
                        Nombre <span class="required-indicator" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="text"
                        id="review-author-name"
                        name="name"
                        class="review-input"
                        required
                        maxlength="70"
                        placeholder="Tu nombre (obligatorio)"
                        autocomplete="off"
                        data-bwignore="true"
                        data-1p-ignore="true"
                        data-lpignore="true"
                        data-form-type="other"
                      />
                      <span class="field-error-msg" id="name-error-msg" aria-live="polite">Por favor ingresa tu nombre (2-70 caracteres).</span>
                    </div>

                    <div class="review-field field-email">
                      <label for="review-author-email" class="review-label">
                        Correo <span class="optional-tag">(opcional)</span>
                      </label>
                      <input
                        type="email"
                        id="review-author-email"
                        name="email"
                        class="review-input"
                        maxlength="100"
                        placeholder="correo@mayor.cl"
                        autocomplete="off"
                        data-bwignore="true"
                        data-1p-ignore="true"
                        data-lpignore="true"
                        data-form-type="other"
                      />
                    </div>
                  </div>

                  <!-- Fila Dedicada: Calificación en Estrellas 1 al 5 -->
                  <div class="review-field field-rating">
                    <fieldset class="rating-fieldset">
                      <legend class="review-label">
                        Calificación <span class="required-indicator" aria-hidden="true">*</span>
                      </legend>
                      <div
                        class="star-rating-control"
                        id="star-rating-control"
                        role="radiogroup"
                        aria-label="Calificación de 1 a 5 estrellas"
                      >
                        {[1, 2, 3, 4, 5].map((val) => (
                          <label class="star-rating-label" data-value={val} title={`${val} de 5 estrellas`}>
                            <input
                              type="radio"
                              name="rating"
                              value={val}
                              class="star-radio-input"
                              required
                              checked={val === 5}
                              data-bwignore="true"
                              data-1p-ignore="true"
                            />
                            <svg class="star-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                              <path
                                fill="currentColor"
                                d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                              />
                            </svg>
                            <span class="visually-hidden">{val} {val === 1 ? 'estrella' : 'estrellas'}</span>
                          </label>
                        ))}
                        <span class="star-rating-desc" id="star-rating-desc" aria-live="polite">Me encantó!</span>
                      </div>
                    </fieldset>
                  </div>

                  <!-- Comentario -->
                  <div class="review-field field-comment">
                    <label for="review-comment-text" class="review-label">
                      Comentario u opinión
                    </label>
                    <textarea
                      id="review-comment-text"
                      name="comment"
                      class="review-textarea"
                      rows="2"
                      maxlength="600"
                      placeholder="Comparte tus impresiones de lectura o claves de discusión..."
                      autocomplete="off"
                      data-bwignore="true"
                      data-1p-ignore="true"
                      data-lpignore="true"
                    ></textarea>
                  </div>

                  <!-- Botón y Estado -->
                  <div class="review-form-actions">
                    <button type="submit" class="review-submit-btn" id="review-submit-btn">
                      <span class="submit-btn-text">Publicar Comentario</span>
                      <svg class="submit-btn-arrow" viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                      </svg>
                    </button>
                    <span class="review-form-feedback" id="review-form-feedback" aria-live="polite"></span>
                  </div>
                </div>
              </div>
            </div>
          </form>

          <!-- Bitácora de Reseñas de los Miembros -->
          <div class="mask-reveal reviews-catalog-mask">
            <div class="mask-reveal-inner">
              <div class="reviews-catalog">
                <div class="reviews-catalog-header">
                  <span class="reviews-catalog-title">OPINIÓN DE LECTORES</span>
                  <span class="reviews-catalog-count" id="reviews-catalog-count">0 registros</span>
                </div>
                <div class="reviews-stack" id="reviews-stack" role="feed" aria-busy="false">
                  <!-- Renderizado dinámicamente -->
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Barra de Scroll Editorial Animada (Entrada y Salida Suaves) -->
      <div class="ficha-scrollbar-track" id="ficha-scrollbar-track" data-cursor="compact" aria-hidden="true">
        <div class="ficha-scrollbar-thumb" id="ficha-scrollbar-thumb"></div>
      </div>
    </div>

      <!-- Columna Derecha: Revelado de Portada por Mancha de Tinta SVG (7 círculos + feTurbulence + feDisplacementMap) -->
      <div class="ficha-col-right">
        <div class="ink-plate-frame">
          <svg
            class="ink-reveal-svg"
            id="ink-reveal-svg"
            viewBox="0 0 648 900"
            role="img"
            aria-label="Ilustración de portada revelada sobre papel"
          >
            <defs>
              {/* color-interpolation-filters="linearRGB" garantiza desplazamiento centrado (media 0.5) sin deriva diagonal */}
              <filter
                id="ink-stain-displacement"
                filterUnits="userSpaceOnUse"
                x="-180"
                y="-180"
                width="1008"
                height="1260"
                color-interpolation-filters="linearRGB"
              >
                <feTurbulence
                  id="ink-turbulence"
                  type="fractalNoise"
                  baseFrequency="0.014 0.018"
                  numOctaves="4"
                  seed="11"
                  result="fractalPaper"
                />
                <feDisplacementMap
                  in="SourceGraphic"
                  in2="fractalPaper"
                  scale="116"
                  xChannelSelector="R"
                  yChannelSelector="G"
                />
              </filter>

              <mask
                id="ink-blot-mask"
                maskUnits="userSpaceOnUse"
                maskContentUnits="userSpaceOnUse"
                x="-180"
                y="-180"
                width="1008"
                height="1260"
              >
                <rect x="-180" y="-180" width="1008" height="1260" fill="#000000" />
                <g filter="url(#ink-stain-displacement)" fill="#ffffff">
                  <circle class="ink-drop" cx="324" cy="450" r="490" data-cx="324" data-cy="450" />
                  <circle class="ink-drop" cx="155" cy="195" r="385" data-cx="155" data-cy="195" />
                  <circle class="ink-drop" cx="493" cy="205" r="390" data-cx="493" data-cy="205" />
                  <circle class="ink-drop" cx="160" cy="705" r="390" data-cx="160" data-cy="705" />
                  <circle class="ink-drop" cx="488" cy="695" r="395" data-cx="488" data-cy="695" />
                  <circle class="ink-drop" cx="328" cy="130" r="350" data-cx="328" data-cy="130" />
                  <circle class="ink-drop" cx="320" cy="770" r="360" data-cx="320" data-cy="770" />
                </g>
              </mask>
            </defs>

            <!-- Sombra impresa sutil del marco editorial -->
            <rect
              x="14"
              y="14"
              width="620"
              height="872"
              fill="none"
              stroke="rgba(24,22,20,0.1)"
              stroke-width="1"
              stroke-dasharray="4 4"
            />

            <!-- Portada editorial dinámica enmascarada orgánicamente por las 7 manchas de tinta -->
            <g mask="url(#ink-blot-mask)">
              <use
                id="ficha-ink-image"
                href={`#editorial-cover-${initialBook?.index ?? 0}`}
                x="0"
                y="0"
                width="648"
                height="900"
              />
              <rect
                x="0"
                y="0"
                width="648"
                height="900"
                fill="none"
                stroke="rgba(24,22,20,0.18)"
                stroke-width="2"
              />
            </g>
          </svg>

          <!-- Sello Ex Libris Patrimonial SIBUM (Opción 2) -->
          <div class="mask-reveal ex-libris-mask">
            <div class="mask-reveal-inner">
              <div class="ficha-ex-libris" aria-hidden="true">
                <img
                  src="/logo.svg"
                  alt=""
                  class="ex-libris-seal-img"
                  width="44"
                  height="44"
                  draggable="false"
                  decoding="async"
                />
                <div class="ex-libris-text">
                  <span class="ex-libris-tag">Club de Lectura</span>
                  <span class="ex-libris-sub">BIBLIOTECA UM · TEMUCO</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Cursor Magnético Personalizado (Anillo de Tinta + Disco Azul Cobalto) -->
<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
